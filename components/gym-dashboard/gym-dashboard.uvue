					<text class="hero-pill-text">连续训练 6 天</text>
				</view>
				<text class="hero-title">本周再练 <text class="hero-title-strong">1</text> 次，就完成目标</text>
				<text class="hero-sub">你已经超过了 72% 的训练者</text>
			</view>
			<view class="progress-ring">
				<image class="progress-ring-img" src="/static/charts/progress-ring.svg" mode="aspectFit"></image>
				<view class="progress-ring-center">
					<text class="progress-ring-value">3</text>
					<text class="progress-ring-total">/ 4 次</text>
