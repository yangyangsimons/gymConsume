<template>
	<view class="rir-backdrop sheet-mask-light" @click.stop="onClose" @touchmove.stop="noop">
		<view class="rir-sheet" @click.stop="noop">
			<view class="sheet-grabber"></view>
			<view class="rir-header">
				<text class="rir-title">{{ setLabel }} · 实际 RIR</text>
				<button class="rir-close" @click="onClose">
					<gym-icon name="close-muted" :size="18"></gym-icon>
				</button>
			</view>
			<text class="rir-help">这组结束后，还能规范完成几次？</text>
			<view class="rir-options">
				<button class="rir-option" :class="{ selected: value === opt.code }" v-for="opt in options" :key="opt.code"
					@click="onPick(opt.code)">{{ opt.label }}</button>
			</view>
			<view class="rir-footer" v-if="value !== ''">
				<button class="rir-clear" @click="onPick('')">清除选择</button>
			</view>
			<view class="rir-safe"></view>
		</view>
	</view>
</template>

<script setup lang="uts">
	type RirOption = {
		code : string
		label : string
	}

	// setLabel 为完整的组名，例如“第 2 组”“热身第 1 组”
	const { value = '', setLabel = '' } = defineProps<{
		value ?: string
		setLabel ?: string
	}>()

	const emit = defineEmits(['select', 'close'])

	const options = ref<RirOption[]>([
		{ code: '0', label: '0' } as RirOption,
		{ code: '1', label: '1' } as RirOption,
		{ code: '2', label: '2' } as RirOption,
		{ code: '3', label: '3' } as RirOption,
		{ code: '4', label: '4' } as RirOption,
		{ code: '5+', label: '5+' } as RirOption,
		{ code: 'unsure', label: '不确定' } as RirOption
	])

	function onPick(code : string) {
		emit('select', code)
	}

	function onClose() {
		emit('close')
	}

	function noop() {
		// 阻止点击面板内容时冒泡到背景层，同时拦截背景滚动
	}
</script>

<style lang="scss">
	@import "@/styles/sheet.scss";

	.rir-backdrop {
		@include sheet-backdrop(40);
	}

	.rir-sheet {
		@include sheet-panel;
		padding-bottom: 16px;
	}

	/* #ifdef MP-WEIXIN */
	.rir-sheet button::after {
		border-width: 0;
	}
	/* #endif */

	.rir-sheet button {
		line-height: 1.4;
		font-family: inherit;
	}

	.rir-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.rir-title {
		color: #1f2a24;
		font-size: 19px;
		font-weight: 700;
	}

	.rir-close {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		margin: 0;
		padding: 0;
		border-width: 0;
		border-radius: 18px;
		background-color: #e9edea;
	}

	.rir-help {
		display: block;
		margin: 6px 0 16px;
		color: #7d8982;
		font-size: 14px;
	}

	.rir-options {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
	}

	.rir-option {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 22%;
		height: 48px;
		margin: 0 3% 10px 0;
		padding: 0;
		border-width: 1px;
		border-style: solid;
		border-color: #e4e9e6;
		border-radius: 12px;
		color: #1f2a24;
		background-color: #ffffff;
		font-size: 17px;
	}

	.rir-option.selected {
		border-color: #1caa70;
		color: #ffffff;
		background-color: #1caf73;
		font-weight: 700;
	}

	.rir-footer {
		display: flex;
		flex-direction: row;
		justify-content: flex-end;
	}

	.rir-clear {
		margin: 0;
		padding: 8px 4px;
		border-width: 0;
		color: #7d8982;
		background-color: transparent;
		font-size: 14px;
	}

	.rir-safe {
		height: env(safe-area-inset-bottom);
	}
</style>
