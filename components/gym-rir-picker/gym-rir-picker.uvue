<template>
	<view class="rir-backdrop" @click.stop="onClose">
		<view class="rir-sheet" @click.stop="noop">
			<view class="rir-handle"></view>
			<view class="rir-header">
				<text class="rir-title">实际 RIR · 第 {{ setLabel }} 组</text>
				<button class="rir-close" @click="onClose">
					<gym-icon name="close-muted" :size="18"></gym-icon>
				</button>
			</view>
			<text class="rir-help">剩余次数 RIR：完成这一组后，你估计还能以相同动作标准再做几次？例如，选择 2，表示大约还能做 2 次。</text>
			<view class="rir-options">
				<button class="rir-option" :class="{ selected: value === opt.code }" v-for="opt in options" :key="opt.code"
					@click="onPick(opt.code)">{{ opt.label }}</button>
			</view>
			<button class="rir-clear" :disabled="value === ''" @click="onPick('')">清除选择</button>
			<view class="rir-safe"></view>
		</view>
	</view>
</template>

<script setup lang="uts">
	type RirOption = {
		code : string
		label : string
	}

	const { value = '', setLabel = '' } = defineProps<{
		value ?: string
		setLabel ?: string
	}>()

	const emit = defineEmits(['select', 'close'])

	const options = ref<RirOption[]>([
		{ code: '0', label: '0' } as RirOption,
		{ code: '1', label: '1' } as RirOption,
		{ code: '2', label: '2' } as RirOption,
		{ code: '3', label: '3' } as RirOption,
		{ code: '4', label: '4' } as RirOption,
		{ code: '5+', label: '5+' } as RirOption,
		{ code: 'unsure', label: '不确定' } as RirOption
	])

	function onPick(code : string) {
		emit('select', code)
	}

	function onClose() {
		emit('close')
	}

	function noop() {
		// 阻止点击面板内容时冒泡到背景层
	}
</script>

<style lang="scss">
	.rir-backdrop {
		position: fixed;
		z-index: 40;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		background-color: #13251ccc;
	}

	.rir-sheet {
		width: 100%;
		padding: 9px 22px 16px;
		border-radius: 28px 28px 0 0;
		background-color: #f8faf8;
	}

	.rir-handle {
		width: 38px;
		height: 14px;
		margin: 0 auto 12px;
		border-radius: 2px;
		background-color: #d5dbd7;
	}

	.rir-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.rir-title {
		font-size: 19px;
		font-weight: 700;
	}

	.rir-close {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-width: 0;
		border-radius: 18px;
		background-color: #e9edea;
	}

	.rir-help {
		display: block;
		margin: 12px 0 16px;
		color: #637168;
		font-size: 14px;
		line-height: 1.6;
	}

	.rir-options {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
	}

	.rir-option {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 22%;
		height: 48px;
		margin: 0 3% 10px 0;
		padding: 0;
		border-width: 1px;
		border-style: solid;
		border-color: #e4e9e6;
		border-radius: 12px;
		color: #1f2a24;
		background-color: #ffffff;
		font-size: 17px;
	}

	.rir-option.selected {
		border-color: #1caa70;
		color: #ffffff;
		background-color: #1caf73;
		font-weight: 700;
	}

	.rir-clear {
		width: 100%;
		height: 46px;
		margin-top: 2px;
		border-width: 1px;
		border-style: solid;
		border-color: #c4cec8;
		border-radius: 12px;
		color: #526159;
		background-color: transparent;
		font-size: 15px;
	}

	.rir-safe {
		height: env(safe-area-inset-bottom);
	}
</style>
