<template>
	<view class="ov-page">
		<scroll-view class="ov-scroll" scroll-y="true">
			<view class="ov-missing" v-if="session == null">
				<text class="ov-missing-title">没有找到这场训练</text>
				<text class="ov-missing-text">它可能已经结束或被清除。这里不会自动创建新的训练，请回到首页开始今天的训练。</text>
			</view>
			<view class="ov-content" v-if="session != null">
				<view class="ov-head">
					<view class="ov-head-top">
						<view class="ov-head-copy">
							<text class="ov-kicker">{{ kicker }}</text>
							<text class="ov-date">{{ dateLabel }}</text>
						</view>
						<text class="ov-tag" :class="{ done: isFinished }">{{ isFinished ? '已结束' : '进行中' }}</text>
					</view>
					<view class="ov-stats" v-if="isFinished">
						<view class="ov-stat">
							<text class="ov-stat-value">{{ totals.workDone }}</text>
							<text class="ov-stat-label">完成正式组</text>
						</view>
						<view class="ov-stat">
							<text class="ov-stat-value">{{ totals.exercisesWithDone }}</text>
							<text class="ov-stat-label">有效动作</text>
						</view>
						<view class="ov-stat">
							<text class="ov-stat-value">{{ totals.volume }}</text>
							<text class="ov-stat-label">容量 kg</text>
						</view>
						<view class="ov-stat">
							<text class="ov-stat-value">{{ minutes }}</text>
							<text class="ov-stat-label">用时 分钟</text>
						</view>
					</view>
					<text class="ov-sub" v-else>{{ totals.exercises }} 个动作 · 已完成 {{ totals.workDone }} 个正式组</text>
				</view>

				<view class="ov-note">
					<text class="ov-note-text">{{ noteText }}</text>
				</view>

				<view class="ov-list">
					<text class="ov-empty" v-if="cards.length === 0">还没有添加动作</text>
					<view class="ov-card" v-for="card in cards" :key="card.id">
						<view class="ov-card-top">
							<view class="ov-card-copy">
								<text class="ov-card-name">{{ card.name }}</text>
								<text class="ov-card-target">{{ card.targetLabel }}</text>
							</view>
							<text class="ov-card-count">{{ card.workDone }}/{{ card.workTarget }}<text class="ov-card-count-unit"> 正式组</text></text>
						</view>
						<view class="ov-bar">
							<view class="ov-bar-fill" :style="{ width: card.pct + '%' }"></view>
						</view>
						<view class="ov-card-bottom">
							<text class="ov-card-detail">{{ card.detail }}</text>
							<view class="ov-card-actions" v-if="!isFinished">
								<button class="ov-link" @click="onEdit(card.index)">编辑</button>
								<button class="ov-link danger" @click="onRemove(card.index)">删除</button>
							</view>
						</view>
					</view>
				</view>

				<button class="ov-add" v-if="!isFinished && cards.length > 0" @click="onAdd">
					<gym-icon name="plus-brand" :size="18"></gym-icon>
					<text>添加动作</text>
				</button>
				<view class="ov-pad"></view>
			</view>
		</scroll-view>

		<view class="ov-footer">
			<button class="ov-secondary" v-if="!isFinished && session != null && session.cloudStatus === 'failed'"
				:disabled="syncing" @click="onRetry">{{ syncing ? '同步中…' : '重试同步草稿' }}</button>
			<view class="ov-footer-row" v-if="session == null">
				<button class="ov-primary" @click="goHome">返回首页</button>
			</view>
			<view class="ov-footer-row" v-else-if="isFinished">
				<button class="ov-secondary" v-if="session != null && session.cloudStatus === 'failed'" :disabled="syncing"
					@click="onRetry">{{ syncing ? '提交中…' : '重试提交' }}</button>
				<button class="ov-primary" @click="goHome">返回首页</button>
			</view>
			<button class="ov-primary" v-else-if="cards.length === 0" @click="onAdd">＋ 添加动作</button>
			<button class="ov-primary" v-else :disabled="busy" @click="onFinish">结束训练</button>
			<view class="ov-safe"></view>
		</view>

		<gym-workout-sheet v-if="sheetOpen" :edit-index="editIndex" @close="onSheetClose" @saved="onSheetSaved"></gym-workout-sheet>
	</view>
</template>

<script setup lang="uts">
	import { formatDate, parseDate } from '@/services/gym-stats.uts'
	import {
		SessionTotals, WorkoutSession, activateSession, durationMinutes, exerciseProgress, exerciseVolume, finishSession, formatTarget,
		loadSession, saveSession, sessionTotals
	} from '@/services/workout-session.uts'
	import { syncSessionToCloud } from '@/services/workout-adapter.uts'
	import { confirmDialog } from '@/services/gym-dialog.uts'

	type ExerciseCard = {
		index : number
		id : string
		name : string
		targetLabel : string
		workDone : number
		workTarget : number
		pct : number
		detail : string
	}

	// sessionId 由路由参数传入；本页面只打开已有训练，从不创建训练。
	// 没有 ID 时只显示当前会话（例如刚结束的训练摘要）。
	const { sessionId = '' } = defineProps<{
		sessionId ?: string
	}>()

	const weekNames : string[] = ['日', '一', '二', '三', '四', '五', '六']

	const session = ref<WorkoutSession | null>(null)
	const sheetOpen = ref<boolean>(false)
	const editIndex = ref<number>(-1)
	const busy = ref<boolean>(false)
	const syncing = ref<boolean>(false)

	function reload() {
		session.value = loadSession()
	}
	onMounted(() => uni.$on('cloud-sync-changed', reload))
	onUnmounted(() => uni.$off('cloud-sync-changed', reload))

	// 指定 ID 时把该训练设为当前会话（ID、开始时间、日期保持不变）；找不到则显示空状态
	if (sessionId != '') activateSession(sessionId)
	reload()
	if (session.value != null && sessionId != '' && session.value.id != sessionId) session.value = null
	// 上次离开时仍有未保存的动作编辑，自动恢复
	if (session.value != null && session.value.status == 'active' && session.value.editing != null) {
		sheetOpen.value = true
	}

	const isFinished = computed(() : boolean => session.value != null && session.value.status == 'finished')

	const kicker = computed(() : string => {
		if (isFinished.value) return 'WORKOUT SUMMARY'
		const s = session.value
		return s != null && s.date == formatDate(new Date()) ? 'TODAY WORKOUT' : 'IN PROGRESS'
	})

	const dateLabel = computed(() : string => {
		if (session.value == null) return ''
		const d = parseDate(session.value.date)
		return (d.getMonth() + 1) + '月' + d.getDate() + '日 · 星期' + weekNames[d.getDay()]
	})

	const totals = computed(() : SessionTotals => {
		if (session.value == null) return { exercises: 0, exercisesWithDone: 0, workDone: 0, warmupDone: 0, unfinished: 0, volume: 0 } as SessionTotals
		return sessionTotals(session.value)
	})

	const minutes = computed(() : number => session.value == null ? 0 : durationMinutes(session.value))

	const cards = computed(() : ExerciseCard[] => {
		const out : ExerciseCard[] = []
		const s = session.value
		if (s == null) return out
		for (let i = 0; i < s.exercises.length; i++) {
			const ex = s.exercises[i]
			const p = exerciseProgress(ex)
			const parts : string[] = []
			if (p.warmupTotal > 0) parts.push('热身 ' + p.warmupDone + '/' + p.warmupTotal)
			if (p.unfinished > 0) parts.push(p.unfinished + ' 组未完成')
			if (s.status == 'finished') parts.push('容量 ' + exerciseVolume(ex) + ' kg')
			out.push({
				index: i,
				id: ex.id,
				name: ex.name,
				targetLabel: formatTarget(ex.target),
				workDone: p.workDone,
				workTarget: p.workTarget,
				pct: p.workTarget > 0 ? Math.min(100, Math.round(p.workDone / p.workTarget * 100)) : 0,
				detail: parts.length > 0 ? parts.join(' · ') : '全部组已完成'
			} as ExerciseCard)
		}
		return out
	})

	const noteText = computed(() : string => {
		const s = session.value
		if (s == null) return ''
		if (s.status == 'active') {
			if (s.cloudStatus == 'synced') return '草稿已同步到云端'
			if (s.cloudStatus == 'failed') return '草稿保留在本机，云端同步失败'
			if (s.date != formatDate(new Date())) return '草稿已保存到本机。这场训练开始于' + dateLabel.value + '，日期不会改为今天。'
			return '草稿已保存到本机'
		}
		if (s.cloudStatus == 'synced') return s.durationSent ? '旧版记录已提交；完整信息保留在本机' : '训练记录已同步到云端'
		if (s.cloudStatus == 'failed') return '云端提交失败，训练记录仍保存在本机，可重试提交。'
		if (s.cloudStatus == 'skipped') return '仅完成了热身组，不计入正式训练，也未提交到云端；记录已保存到本机。'
		return '训练记录已保存到本机。'
	})

	function goHome() {
		uni.switchTab({ url: '/pages/home/home' })
	}

	function onAdd() {
		editIndex.value = -1
		sheetOpen.value = true
	}

	function onEdit(index : number) {
		editIndex.value = index
		sheetOpen.value = true
	}

	async function onRemove(index : number) {
		const s = session.value
		if (s == null || index < 0 || index >= s.exercises.length) return
		const ex = s.exercises[index]
		const ok = await confirmDialog('删除动作', '将从本次训练中移除“' + ex.name + '”及其所有组记录。', '删除', '取消')
		if (!ok) return
		s.exercises.splice(index, 1)
		if (!saveSession(s)) uni.showToast({ title: '本机保存失败，请重试', icon: 'none' })
		reload()
	}

	function onSheetClose() {
		sheetOpen.value = false
		reload()
	}

	function onSheetSaved() {
		sheetOpen.value = false
		reload()
	}

	async function runSync(s : WorkoutSession) {
		syncing.value = true
		try {
			await syncSessionToCloud(s)
		} catch (e) {
			console.error('Training sync failed; local record retained', e)
			uni.showToast({ title: '同步失败，本机数据已保留', icon: 'none' })
		}
		syncing.value = false
		reload()
	}

	async function onFinish() {
		const s = session.value
		if (s == null || busy.value || s.status != 'active') return
		const t = sessionTotals(s)
		if (t.workDone + t.warmupDone == 0) {
			const ok = await confirmDialog('没有完成的组', '还没有完成任何一组，结束后不会产生训练记录，已填写的内容也会被清除。', '结束', '返回继续')
			if (!ok) return
			if (finishSession(s) == 'stale') {
				uni.showToast({ title: '这场训练状态已变化，请重新进入', icon: 'none' })
				reload()
				return
			}
			uni.switchTab({
				url: '/pages/home/home',
				success: () => {
					uni.showToast({ title: '没有完成的组，未产生训练记录', icon: 'none' })
				}
			})
			return
		}
		let content = '本次共完成 ' + t.workDone + ' 个正式组。'
		if (t.unfinished > 0) content = '还有 ' + t.unfinished + ' 个组未完成，结束后不会计入统计，也不会被自动标记为完成。'
		const ok = await confirmDialog('结束本次训练？', content, '结束训练', '返回继续')
		if (!ok) return
		busy.value = true
		if (finishSession(s) == 'stale') {
			uni.showToast({ title: '这场训练状态已变化，请重新进入', icon: 'none' })
			reload()
			busy.value = false
			return
		}
		reload()
		if (s.cloudStatus == 'pending') await runSync(s)
		busy.value = false
	}

	async function onRetry() {
		const s = session.value
		if (s == null || syncing.value) return
		await runSync(s)
	}
</script>

<style lang="scss">
	.ov-page {
		display: flex;
		flex-direction: column;
		flex: 1;
		width: 100%;
		height: 100%;
