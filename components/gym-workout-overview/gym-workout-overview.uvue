		font-size: 12px;
		line-height: 1.6;
	}

	.ov-list {
		margin-top: 16px;
	}

	.ov-empty {
		display: block;
		padding: 28px 0;
		color: #949d98;
		font-size: 14px;
		text-align: center;
	}

	.ov-card {
		margin-bottom: 12px;
		padding: 16px;
		border-width: 1px;
		border-style: solid;
		border-color: #e9edea;
		border-radius: 18px;
		background-color: #ffffff;
	}

	.ov-card-top {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.ov-card-copy {
		flex: 1;
		margin-right: 12px;
	}

	.ov-card-name {
		display: block;
		color: #1f2a24;
		font-size: 17px;
		font-weight: 700;
		line-height: 1.35;
	}

	.ov-card-target {
		display: block;
		margin-top: 4px;
		color: #7d8982;
		font-size: 12px;
	}

	.ov-card-count {
		color: #159b65;
		font-size: 22px;
		font-weight: 700;
		white-space: nowrap;
	}

