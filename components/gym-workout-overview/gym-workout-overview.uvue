		display: block;
		margin-top: 12px;
		color: #bdd3c8;
		font-size: 14px;
	}

	.ov-stats {
		display: flex;
		flex-direction: row;
		margin-top: 16px;
	}

	.ov-stat {
		flex: 1;
	}

	.ov-stat-value {
		display: block;
		color: #70e6ad;
		font-size: 22px;
		font-weight: 700;
	}

	.ov-stat-label {
		display: block;
		margin-top: 4px;
		color: #bdd3c8;
		font-size: 11px;
	}

	.ov-note {
		margin-top: 12px;
		padding: 10px 12px;
		border-radius: 12px;
		background-color: #edf2ef;
	}

