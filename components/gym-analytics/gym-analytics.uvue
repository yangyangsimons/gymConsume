<template>
	<view>
		<view class="page-header">
			<text class="eyebrow">你的训练表现</text>
			<text class="heading-1">数据统计</text>
		</view>

		<view class="stat-grid">
			<view class="stat-card">
				<text class="stat-label">总训练</text>
				<text class="stat-value">{{ overview.count }}<text class="stat-unit"> 次</text></text>
				<text class="stat-meta">近 90 天</text>
			</view>
			<view class="stat-card">
				<text class="stat-label">训练容量</text>
				<text class="stat-value">{{ overview.tons }}<text class="stat-unit"> 吨</text></text>
				<text class="stat-meta positive" v-if="overview.hasPrev">{{ overview.tonsChangePct >= 0 ? '↑' : '↓' }} {{ Math.abs(overview.tonsChangePct) }}%</text>
				<text class="stat-meta" v-else>暂无对比</text>
			</view>
			<view class="stat-card">
				<text class="stat-label">训练时长</text>
				<text class="stat-value">{{ overview.hours }}<text class="stat-unit"> h</text></text>
				<text class="stat-meta">平均 {{ overview.avgMinutes }} 分钟</text>
			</view>
		</view>

		<view class="section-block analytics-card">
			<view class="section-heading">
				<view>
					<text class="section-kicker">CONSISTENCY</text>
					<text class="section-title">训练频率</text>
				</view>
				<picker mode="selector" :range="periods" :value="periodIndex" @change="onPeriodChange">
					<view class="period-select">{{ periods[periodIndex] }}</view>
				</picker>
			</view>
			<view class="heatmap">
				<view class="heat-cell" :class="'heat-' + value" v-for="(value, idx) in heatValues" :key="idx"></view>
			</view>
			<view class="heatmap-labels">
				<text class="heatmap-month">{{ heatLabels[0] }}</text>
				<text class="heatmap-month">{{ heatLabels[1] }}</text>
				<text class="heatmap-month">{{ heatLabels[2] }}</text>
				<view class="heatmap-legend">
					<text>少</text>
					<view class="heat-cell heat-1"></view>
					<view class="heat-cell heat-3"></view>
					<text>多</text>
				</view>
			</view>
		</view>

		<view class="section-block analytics-card">
			<view class="section-heading">
				<view>
					<text class="section-kicker">STRENGTH</text>
					<text class="section-title">卧推趋势</text>
				</view>
				<text class="pr-chip">PR {{ trend.pr }} kg</text>
			</view>
			<view class="chart-value">
				<text class="chart-value-strong">{{ trend.totalVolume }}</text>
				<text class="chart-value-unit">kg 总容量</text>
			</view>
			<view class="bar-chart">
				<view class="bar-col" v-for="bar in trend.bars" :key="bar.label">
					<view class="bar" :style="{ height: bar.height + 'px' }"></view>
				</view>
			</view>
			<view class="chart-labels">
				<text v-for="bar in trend.bars" :key="bar.label">{{ bar.label }}</text>
			</view>
		</view>

		<view class="section-block analytics-card">
			<view class="section-heading">
				<view>
					<text class="section-kicker">BALANCE</text>
					<text class="section-title">部位分布</text>
				</view>
			</view>
			<view class="muscle-bar">
				<view class="muscle-seg" :class="muscleColors[idx]" :style="{ width: share.percent + '%' }"
					v-for="(share, idx) in muscle.shares" :key="share.name"></view>
			</view>
			<view class="distribution-content">
				<view class="muscle-total">
					<text class="donut-value">{{ muscle.totalSets }}</text>
					<text class="donut-label">总组数 · 近 90 天</text>
				</view>
				<view class="muscle-list">
					<view class="muscle-row" v-for="(share, idx) in muscle.shares" :key="share.name">
						<view class="muscle-dot" :class="muscleColors[idx]"></view>
						<text class="muscle-name">{{ share.name }}</text>
						<text class="muscle-value">{{ share.percent }}%</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ExerciseTrend, MuscleStats, Overview, Workout, addDays, calcExerciseTrend, calcHeatmap, calcMuscleStats, calcOverview } from '@/services/gym-stats.uts'
	import { loadWorkouts } from '@/services/gym-api.uts'

	const BENCH_ID = 'chest-01'
	const muscleColors : string[] = ['green', 'blue', 'orange', 'gray']

	const workouts = ref<Workout[]>([])
	const today = ref<Date>(new Date())

	const periods = ref<string[]>(['近 12 周', '近 20 周'])
	const periodIndex = ref(0)
	const periodDays = computed(() : number => periodIndex.value == 0 ? 84 : 140)

	const overview = computed(() : Overview => calcOverview(workouts.value, today.value))
	const heatValues = computed(() : number[] => calcHeatmap(workouts.value, today.value, periodDays.value))
	const trend = computed(() : ExerciseTrend => calcExerciseTrend(workouts.value, BENCH_ID, today.value, 4))
	const muscle = computed(() : MuscleStats => calcMuscleStats(workouts.value, today.value))

	const heatLabels = computed(() : string[] => {
		const n = periodDays.value
		const pick = (back : number) : string => (addDays(today.value, -back).getMonth() + 1) + '月'
		return [pick(n - 1), pick(Math.round(n / 2)), pick(0)]
	})

	function refresh() {
		today.value = new Date()
		loadWorkouts().then((list : Workout[]) => {
			workouts.value = list
		}).catch(() => {
			uni.showToast({ title: '统计数据加载失败', icon: 'none' })
		})
	}

	function onSaved() {
		refresh()
	}

	onMounted(() => {
		refresh()
		uni.$on('workout-saved', onSaved)
	})

	onUnmounted(() => {
		uni.$off('workout-saved', onSaved)
	})

	type PickerChangeEventDetail = {
		value : string
	}
	type PickerChangeEvent = {
		detail : PickerChangeEventDetail
	}

	function onPeriodChange(e : PickerChangeEvent) {
		periodIndex.value = parseInt(e.detail.value)
	}
</script>

