<template>
	<view class="an-root">
		<scroll-view class="app-content" scroll-y="true">
		<view class="page-header">
			<text class="eyebrow">你的训练表现</text>
			<text class="heading-1">数据统计</text>
		</view>

		<view class="demo-banner" v-if="demoMode">
			<text class="demo-banner-title">演示数据</text>
			<text class="demo-banner-text">当前页面显示的是本地生成的示例数据，不是你的真实训练记录，也不会读写云端。把 services/gym-demo.uts 中的 DEMO_MODE 改为 false 即可恢复真实数据。</text>
		</view>
		<text class="load-note" v-else-if="cloudState === 'failed'">云端训练记录加载失败，当前仅显示本机记录。</text>

		<view class="stat-grid">
			<view class="stat-card first">
				<text class="stat-label">训练天数</text>
				<text class="stat-value">{{ overview.days }}<text class="stat-unit"> 天</text></text>
				<text class="stat-meta">近 90 天</text>
			</view>
			<view class="stat-card">
				<text class="stat-label">训练容量</text>
				<text class="stat-value">{{ volumeText.value }}<text class="stat-unit"> {{ volumeText.unit }}</text></text>
				<text class="stat-meta positive" v-if="overview.hasPrev">{{ overview.tonsChangePct >= 0 ? '↑' : '↓' }} {{ Math.abs(overview.tonsChangePct) }}% 较前 90 天</text>
				<text class="stat-meta" v-else>近 90 天</text>
			</view>
			<view class="stat-card">
				<text class="stat-label">训练时长</text>
				<text class="stat-value">{{ durationText.value }}<text class="stat-unit" v-if="durationText.unit !== ''"> {{ durationText.unit }}</text></text>
				<text class="stat-meta">{{ avgText }}</text>
			</view>
		</view>

		<gym-heatmap :entries="entries" :today="today" :demo="demoMode"></gym-heatmap>

		<gym-exercise-performance :entries="entries" :library="library" :today="today" :demo="demoMode"
			@open-picker="onOpenPicker"></gym-exercise-performance>

		<view class="analytics-card">
			<view class="section-heading">
				<view>
					<text class="section-kicker">BALANCE</text>
					<text class="section-title">部位分布</text>
				</view>
				<text class="demo-tag" v-if="demoMode">演示数据</text>
			</view>
			<view class="muscle-bar">
				<view class="muscle-seg" :class="muscleColors[idx]" :style="{ width: share.percent + '%' }"
					v-for="(share, idx) in muscle.shares" :key="share.name"></view>
			</view>
			<view class="distribution-content">
				<view class="muscle-total">
					<text class="donut-value">{{ muscle.totalSets }}</text>
					<text class="donut-label">总组数 · 近 90 天</text>
				</view>
				<view class="muscle-list">
					<view class="muscle-row" v-for="(share, idx) in muscle.shares" :key="share.name">
						<view class="muscle-dot" :class="muscleColors[idx]"></view>
						<text class="muscle-name">{{ share.name }}</text>
						<text class="muscle-value">{{ share.percent }}%</text>
					</view>
				</view>
			</view>
		</view>
		</scroll-view>

		<!-- 弹层放在 scroll-view 之外，避免 iOS 真机上 fixed 被滚动容器限制成内容宽度 -->
		<gym-exercise-picker v-if="showPicker" :options="pickerOptions" :selected-id="pickerSelected"
			@select="onPickExercise" @close="showPicker = false"></gym-exercise-picker>
	</view>
</template>

<script setup lang="uts">
	import { Exercise, Workout, formatDate } from '@/services/gym-stats.uts'
	import { loadExercises, loadWorkouts } from '@/services/gym-api.uts'
	import { WorkoutSession, loadHistorySessions, loadSession } from '@/services/workout-session.uts'
	import { DayEntry, buildDayEntries } from '@/services/gym-calendar.uts'
	import { ExerciseOption, MuscleStats, Overview, ValueUnit, calcMuscleStats, calcOverview, formatDuration, formatVolume } from '@/services/gym-insights.uts'
	import { DEMO_MODE, demoExercises, demoSessions } from '@/services/gym-demo.uts'

	type PickerPayload = {
		options : ExerciseOption[]
		selectedId : string
	}

	const muscleColors : string[] = ['green', 'blue', 'orange', 'gray']
	const demoMode : boolean = DEMO_MODE

	const workouts = ref<Workout[]>([])
	const sessions = ref<WorkoutSession[]>([])
	const exercises = ref<Exercise[]>([])
	// loading | ok | failed
	const cloudState = ref<string>('loading')
	const today = ref<string>(formatDate(new Date()))

	// 动作选择弹层由本组件（scroll-view 之外）渲染，动作表现卡片通过事件请求打开、通过事件接收选择
	const showPicker = ref<boolean>(false)
	const pickerOptions = ref<ExerciseOption[]>([])
	const pickerSelected = ref<string>('')

	function onOpenPicker(p : PickerPayload) {
		pickerOptions.value = p.options
		pickerSelected.value = p.selectedId
		showPicker.value = true
	}

	function onPickExercise(id : string) {
		showPicker.value = false
		uni.$emit('exercise-performance-pick', id)
	}

	// 热力图、动作表现、概览、部位分布共用这一份记录（与首页同一数据源和计入规则）。
	// 演示模式只使用本地生成的演示会话，不读取真实历史。
	const entries = computed(() : DayEntry[] => {
		if (demoMode) return buildDayEntries([], demoSessions(today.value), true)
		return buildDayEntries(workouts.value, sessions.value, cloudState.value == 'ok')
	})
	const library = computed(() : Exercise[] => demoMode ? demoExercises() : exercises.value)

	const overview = computed(() : Overview => calcOverview(entries.value, today.value))
	const muscle = computed(() : MuscleStats => calcMuscleStats(entries.value, today.value))
	const volumeText = computed(() : ValueUnit => formatVolume(overview.value.volumeKg))
	const durationText = computed(() : ValueUnit => formatDuration(overview.value.minutes))
	const avgText = computed(() : string => overview.value.minutes > 0 && overview.value.days > 0 ? '平均 ' + overview.value.avgMinutes + ' 分钟 / 次' : '暂无时长记录')

	function refreshLocal() {
		today.value = formatDate(new Date())
		if (demoMode) return
		const out : WorkoutSession[] = []
		const cur = loadSession()
		if (cur != null) out.push(cur)
		const hist = loadHistorySessions()
		for (let i = 0; i < hist.length; i++) out.push(hist[i])
		sessions.value = out
	}

	function refreshCloud() {
		if (demoMode) return
		loadWorkouts().then((list : Workout[]) => {
			workouts.value = list
			cloudState.value = 'ok'
		}).catch(() => {
			cloudState.value = 'failed'
			uni.showToast({ title: '统计数据加载失败', icon: 'none' })
		})
	}

	function refreshLibrary() {
		if (demoMode) return
		loadExercises().then((list : Exercise[]) => {
			exercises.value = list
		}).catch(() => {
			exercises.value = []
		})
	}

	function onSaved() {
		refreshLocal()
		refreshCloud()
	}

	onMounted(() => {
		refreshLocal()
		refreshCloud()
		refreshLibrary()
		uni.$on('workout-saved', onSaved)
		uni.$on('workout-session-changed', refreshLocal)
	})

	onUnmounted(() => {
		uni.$off('workout-saved', onSaved)
		uni.$off('workout-session-changed', refreshLocal)
	})
</script>

<style lang="scss">
	@import "@/styles/analytics-card.scss";
	@import "@/styles/page-layout.scss";

	.an-root {
		width: 100%;
		height: 100%;
	}

	.page-header {
		padding: 4px 2px 22px;
	}

	.eyebrow {
		display: block;
		margin-bottom: 6px;
		color: #7d8982;
		font-size: 11px;
		font-weight: 700;
	}

	.heading-1 {
		font-size: 25px;
	}

	.demo-banner {
		margin-bottom: 14px;
		padding: 12px 14px;
		border-radius: 14px;
		background-color: #fdf0dc;
	}

	.demo-banner-title {
		display: block;
		color: #a35f0f;
		font-size: 13px;
		font-weight: 700;
	}

	.demo-banner-text {
		display: block;
		margin-top: 4px;
		color: #8a5a1e;
		font-size: 12px;
		line-height: 1.6;
	}

	.load-note {
		display: block;
		margin-bottom: 12px;
		color: #b5762a;
		font-size: 12px;
	}

	.stat-grid {
		display: flex;
		flex-direction: row;
	}

	.stat-card {
		flex: 1;
		min-width: 0;
		margin-left: 8px;
		padding: 14px 12px;
		border-width: 1px;
		border-style: solid;
		border-color: #e7ebe8;
		border-radius: 17px;
		background-color: #ffffff;
	}

	.stat-card.first {
		margin-left: 0;
	}

	.stat-label {
		display: block;
		color: #89938d;
		font-size: 11px;
	}

	.stat-value {
		display: block;
		margin: 6px 0 3px;
		font-size: 21px;
	}

	.stat-unit {
		margin-left: 3px;
		font-size: 11px;
		font-weight: 500;
	}

	.stat-meta {
		display: block;
		color: #9ca49f;
		font-size: 10px;
	}

	.stat-meta.positive {
		color: #17a669;
	}

	.distribution-content {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-around;
	}

	.muscle-bar {
		display: flex;
		flex-direction: row;
		height: 10px;
		margin-bottom: 18px;
		border-radius: 5px;
		background-color: #edf1ee;
		overflow: hidden;
	}

	.muscle-seg {
		height: 10px;
	}

	.muscle-total {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 115px;
	}

	.donut-value {
		font-size: 21px;
	}

	.donut-label {
		margin-top: 2px;
		color: #8a948e;
		font-size: 10px;
	}

	.muscle-list {
		width: 130px;
	}

	.muscle-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin: 8px 0;
		color: #76817b;
		font-size: 11px;
	}

	.muscle-dot {
		width: 7px;
		height: 7px;
		margin-right: 7px;
		border-radius: 4px;
	}

	.muscle-name {
		flex: 1;
	}

	.muscle-value {
		color: #354139;
	}

	.green {
		background-color: #26bd7c;
	}

	.blue {
		background-color: #5a91e3;
	}

	.orange {
		background-color: #e4a85b;
	}

	.gray {
		background-color: #d9dfdb;
	}
</style>
