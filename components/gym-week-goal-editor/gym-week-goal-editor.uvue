		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.wg-title {
		color: #1f2a24;
		font-size: 20px;
		font-weight: 700;
	}

	.wg-close {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		margin: 0;
		padding: 0;
		border-width: 0;
		border-radius: 18px;
		background-color: #e9edea;
	}

	.wg-body {
		margin-top: 14px;
	}

	.wg-field {
		margin-bottom: 12px;
		padding: 12px 14px;
		border-width: 1px;
		border-style: solid;
		border-color: #e7ebe8;
		border-radius: 16px;
		background-color: #ffffff;
	}

	.wg-label {
		display: block;
		margin-bottom: 10px;
		color: #1f2a24;
		font-size: 15px;
		font-weight: 700;
	}

	.wg-chips {
		display: flex;
		flex-direction: row;
	}

	.wg-chip {
		display: flex;
		flex: 1;
		align-items: center;
		justify-content: center;
		height: 42px;
		margin: 0 6px 0 0;
		padding: 0;
		border-width: 1px;
		border-style: solid;
		border-color: #e4e9e6;
		border-radius: 11px;
		color: #717c76;
		background-color: #ffffff;
		font-size: 16px;
		font-weight: 600;
	}

	.wg-chip.active,
	.wg-effect.active {
		border-color: #1caa70;
		color: #ffffff;
		background-color: #1caf73;
	}

	.wg-effect {
		display: flex;
		flex: 1;
		align-items: center;
		justify-content: center;
		height: 40px;
		margin: 0 8px 0 0;
		padding: 0 14px;
		border-width: 1px;
		border-style: solid;
		border-color: #e4e9e6;
		border-radius: 11px;
		color: #717c76;
		background-color: #ffffff;
		font-size: 14px;
	}

	.wg-summary {
		display: block;
		color: #25805d;
		font-size: 14px;
		font-weight: 600;
	}

	.wg-note {
		display: block;
		margin-top: 8px;
		color: #a0a8a3;
		font-size: 12px;
		text-align: center;
	}

	.wg-footer {
		padding: 12px 0;
	}

	.wg-save {
		width: 100%;
		margin: 0;
		padding: 15px;
		border-width: 0;
		border-radius: 14px;
		color: #ffffff;
		background-color: #1db676;
		font-size: 17px;
		font-weight: 700;
	}

	.wg-save.is-disabled {
		opacity: 0.45;
	}

	.wg-safe {
		height: env(safe-area-inset-bottom);
	}
</style>
