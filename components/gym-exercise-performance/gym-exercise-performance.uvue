	}

	.pf-detail {
		margin-top: 8px;
		padding: 12px 14px;
		border-radius: 14px;
		background-color: #f1faf5;
	}

	.pf-detail-top {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.pf-detail-date {
		color: #526159;
		font-size: 13px;
		font-weight: 600;
	}

	.pf-detail-close {
		padding: 4px 0 4px 12px;
		color: #7d8982;
		font-size: 13px;
	}

	.pf-detail-main {
		display: flex;
		flex-direction: row;
		align-items: baseline;
		margin-top: 4px;
	}

	.pf-detail-value {
		margin-right: 6px;
		color: #1f2a24;
		font-size: 22px;
		font-weight: 700;
	}

	.pf-detail-unit {
		color: #6e7973;
		font-size: 12px;
	}

	.pf-detail-line {
		display: block;
		margin-top: 4px;
		color: #4a5650;
		font-size: 12px;
		line-height: 1.6;
	}

	.pf-sets {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 8px;
	}

	.pf-set {
		margin: 0 6px 6px 0;
		padding: 3px 10px;
		border-radius: 8px;
		color: #3f4c45;
		background-color: #ffffff;
		font-size: 12px;
	}

	.pf-set.top {
		color: #1c8f5e;
		background-color: #dff3e8;
		font-weight: 600;
	}

	.pf-detail-note {
		display: block;
		margin-top: 2px;
		color: #b5762a;
		font-size: 11px;
	}

	.pf-last {
		display: block;
		margin-top: 12px;
		color: #4a5650;
		font-size: 13px;
		line-height: 1.6;
	}

	.pf-foot {
		display: block;
		margin-top: 8px;
		color: #a0aaa4;
		font-size: 11px;
	}
</style>
