<template>
	<view class="analytics-card">
		<view class="section-heading">
			<view>
				<text class="section-kicker">STRENGTH</text>
				<text class="section-title">力量趋势</text>
			</view>
			<text class="demo-tag" v-if="demo">演示数据</text>
		</view>

		<view class="pf-select" @click="openPicker">
			<text class="pf-select-name">{{ exerciseName }}</text>
			<text class="pf-select-arrow">▾</text>
		</view>

		<view class="pf-metrics">
			<text class="pf-chip" :class="{ active: metric === 'e1rm' }" @click="setMetric('e1rm')" v-if="!isBodyweightAction">估算 1RM</text>
			<text class="pf-chip" :class="{ active: metric === 'weight' }" @click="setMetric('weight')" v-if="!isBodyweightAction">最高重量</text>
			<text class="pf-chip" :class="{ active: metric === 'maxReps' }" @click="setMetric('maxReps')" v-if="isBodyweightAction">单组最多次数</text>
			<text class="pf-chip" :class="{ active: metric === 'totalReps' }" @click="setMetric('totalReps')" v-if="isBodyweightAction">总次数</text>
			<text class="pf-chip" :class="{ active: metric === 'volume' }" @click="setMetric('volume')" v-if="!isBodyweightAction">训练容量</text>
		</view>

		<text class="pf-empty" v-if="options.length === 0">还没有可选择的动作。</text>
		<text class="pf-empty" v-else-if="trend.total === 0">该动作还没有已结束训练的记录。</text>
		<text class="pf-empty" v-else-if="trend.points.length === 0">{{ noRangeText }}</text>

		<view v-if="chartVisible">
			<view class="pf-head">
				<text class="pf-head-value">{{ headValue }}</text>
				<text class="pf-head-unit">{{ headUnit }}</text>
			</view>
			<text class="pf-head-sub">{{ headSub }}</text>
			<text class="pf-head-best" v-if="headBest != ''">{{ headBest }}</text>
			<text class="pf-range-sum">{{ rangeSummary }}</text>

			<view class="pf-chart-wrap">
				<view class="pf-yaxis">
					<text class="pf-axis-label">{{ axisTop }}</text>
					<text class="pf-axis-label">{{ axisMid }}</text>
					<text class="pf-axis-label">{{ axisBottom }}</text>
				</view>
				<canvas type="2d" id="pfChart" class="pf-canvas"
					bindtap="onCanvasTap"></canvas>
			</view>
			<text class="pf-smooth-tip" v-if="trend.points.length > 0 && trend.points.length < 3">再练 {{ 3 - trend.points.length }} 次生成平滑趋势</text>

			<view class="pf-detail" v-if="selected != null">
				<view class="pf-detail-top">
					<text class="pf-detail-date">{{ selectedTitle }}</text>
					<text class="pf-detail-close" @click="closeDetail">收起</text>
				</view>
				<view class="pf-detail-main">
					<text class="pf-detail-value">{{ selectedValue }}</text>
					<text class="pf-detail-unit">{{ headUnit }}</text>
				</view>
				<text class="pf-detail-line">{{ selectedLine }}</text>
				<view class="pf-sets">
					<text class="pf-set" :class="{ top: s.top }" v-for="(s, i) in selectedSets" :key="i">{{ s.text }}</text>
				</view>
			</view>
		</view>

		<text class="pf-foot" v-if="occs.unlinked > 0">另有 {{ occs.unlinked }} 条缺少动作 ID 的旧记录未纳入。</text>
	</view>
</template>

<script setup lang="uts">
	import { getCurrentInstance } from 'vue'
	import { DayEntry } from '@/services/gym-calendar.uts'
	import { Exercise, aliasExerciseId, isBodyweight } from '@/services/gym-stats.uts'
	import {
		ExerciseOption, InsightPrefs, METRIC_E1RM, METRIC_MAX_REPS, METRIC_TOTAL_REPS, METRIC_VOLUME, METRIC_WEIGHT,
		OccurrenceSet, TrendPoint, TrendResult, WEIGHT_UNIT, buildExerciseOptions, buildTrend, clockLabel, collectOccurrences,
		defaultMetricForOption, defaultPrefs, metricLabel, resolveExerciseId, RANGE_4W, RANGE_12W, RANGE_6M, rangeDays, slashDate, shortDate, volumeFormula, calcRange
	} from '@/services/gym-insights.uts'
	import { loadInsightPrefs, saveInsightPrefs } from '@/services/gym-insights-data.uts'

	type SetChip = {
		text : string
		top : boolean
	}
	type PickerPayload = {
		options : ExerciseOption[]
		selectedId : string
	}
	type ChartDataPoint = { x : number, y : number, index : number }
	type PRMark = { x : number, y : number, label : string, prType : string }

	const props = defineProps<{
		entries : DayEntry[]
		library : Exercise[]
		today : string
		demo ?: boolean
		range ?: string  // RANGE_4W | RANGE_12W | RANGE_6M
	}>()

	const emit = defineEmits(['open-picker'])

	const CHART_PLOT_HEIGHT = 140
	const CHART_CSS_HEIGHT = 160  // 含上下 padding
	const CHART_PADDING_LEFT = 12
	const CHART_PADDING_RIGHT = 12
	const CHART_PADDING_TOP = 16
	const CHART_PADDING_BOTTOM = 8
	const UNIT = WEIGHT_UNIT

	const prefs = ref<InsightPrefs>(defaultPrefs())
	const selectedKey = ref<string>('')
	const canvasReady = ref<boolean>(false)
	const chartDataPoints = ref<ChartDataPoint[]>([])
	const chartPRMarks = ref<PRMark[]>([])

	const rangeKey = computed(() : string => {
		if (props.range != null) return props.range
		return RANGE_12W
	})
	const rangeDaysValue = computed(() : number => rangeDays(rangeKey.value))

	const occs = computed(() : OccurrenceSet => collectOccurrences(props.entries))
	const options = computed(() : ExerciseOption[] => buildExerciseOptions(props.library, occs.value.items))
	const exerciseId = computed(() : string => resolveExerciseId(options.value, prefs.value.exerciseId))
	const current = computed(() : ExerciseOption | null => {
		for (let i = 0; i < options.value.length; i++) {
			if (options.value[i].id == exerciseId.value) return options.value[i]
		}
		return null
	})
	const exerciseName = computed(() : string => current.value == null ? '选择动作' : current.value.name)
	const isBodyweightAction = computed(() : boolean => isBodyweight(exerciseId.value, props.library))

	// 解析后的 metric：''（自动默认）或当前动作不支持时，按动作类型回退默认
	const metric = computed(() : string => {
		const m = prefs.value.metric
		const bw = isBodyweightAction.value
		if (m != '') {
			if (bw) {
				if (m == METRIC_MAX_REPS || m == METRIC_TOTAL_REPS) return m
			} else {
				if (m == METRIC_E1RM || m == METRIC_WEIGHT || m == METRIC_VOLUME) return m
			}
		}
		if (current.value == null) return bw ? METRIC_MAX_REPS : METRIC_E1RM
		return defaultMetricForOption(current.value, props.library)
	})

	const trend = computed(() : TrendResult => buildTrend(occs.value.items, exerciseId.value, current.value == null ? '' : current.value.category, metric.value, props.today, rangeDaysValue.value, props.library))

	const chartVisible = computed(() : boolean => trend.value.points.length > 0 && trend.value.supported)

	const rangeSummary = computed(() : string => {
		const label = rangeKey.value == RANGE_4W ? '近 4 周' : (rangeKey.value == RANGE_6M ? '近半年' : '近 12 周')
		let text = label + ' · ' + trend.value.points.length + ' 次训练'
		return text
	})
	const noRangeText = computed(() : string => {
		const last = trend.value.last
		let text = rangeKey.value == RANGE_4W ? '近 4 周' : (rangeKey.value == RANGE_6M ? '近半年' : '近 12 周')
		text += '内没有该动作的训练记录'
		if (last != null) text += '，最近一次在 ' + shortDate(last.date)
		return text + '。'
	})

	// 最新一次（范围内） vs 第一次 的对比
	const headValue = computed(() : string => {
		const pts = trend.value.points
		if (pts.length == 0) return ''
		return '' + pts[pts.length - 1].value
	})
	const headUnit = computed(() : string => {
		if (metric.value == METRIC_MAX_REPS || metric.value == METRIC_TOTAL_REPS) return '次'
		return UNIT
	})
	const headSub = computed(() : string => {
		const pts = trend.value.points
		if (pts.length < 1) return ''
		const latest = pts[pts.length - 1]
		let diffText = ''
		if (pts.length >= 2) {
			const first = pts[0]
			const diff = latest.value - first.value
			const pct = first.value > 0 ? Math.round(diff / first.value * 100) : 0
			diffText = diff >= 0 ? ('↑' + diff + ' (+' + pct + '%)') : ('↓' + Math.abs(diff) + ' (' + pct + '%)')
		}
		return shortDate(latest.date) + (diffText != '' ? ' · ' + diffText : '')
	})

	// 范围内最后一次训练的最佳组（totalReps 指标或无有效组时不显示）
	const headBest = computed(() : string => {
		if (metric.value == METRIC_TOTAL_REPS) return ''
		const pts = trend.value.points
		if (pts.length == 0) return ''
		const bs = pts[pts.length - 1].bestSet
		if (bs == null) return ''
		if (bs.weight > 0) return '最佳组 ' + bs.weight + 'kg × ' + bs.reps
		return '最佳组 ' + bs.reps + ' 次'
	})

	const axisTop = computed(() : string => '' + trend.value.ticks[2])
	const axisMid = computed(() : string => '' + trend.value.ticks[1])
	const axisBottom = computed(() : string => '' + trend.value.ticks[0])

	const selected = computed(() : TrendPoint | null => {
		if (selectedKey.value == '') return null
		const pts = trend.value.points
		for (let i = 0; i < pts.length; i++) {
			if (pts[i].key == selectedKey.value) return pts[i]
		}
		return null
	})
	const selectedTitle = computed(() : string => {
		const p = selected.value
		if (p == null) return ''
		let text = shortDate(p.date)
		if (p.countOnDate > 1) text += ' · 当天第 ' + p.seq + ' 次'
		const clk = clockLabel(p.at)
		if (clk != '') text += ' · ' + clk
		return text
	})
	const selectedValue = computed(() : string => selected.value == null ? '' : '' + selected.value.value)
	const selectedLine = computed(() : string => {
		const p = selected.value
		if (p == null) return ''
		if (metric.value == METRIC_VOLUME) return volumeFormula(p)
		const tops : string[] = []
		for (let i = 0; i < p.topSets.length; i++) tops.push(p.topSets[i].weight + ' × ' + p.topSets[i].reps)
		return '对应记录：' + tops.join('、') + ' ' + UNIT
	})
	const selectedSets = computed(() : SetChip[] => {
		const out : SetChip[] = []
		const p = selected.value
		if (p == null) return out
		for (let i = 0; i < p.sets.length; i++) {
			const s = p.sets[i]
			const valid = s.weight > 0 && s.reps > 0
			out.push({
				text: valid ? s.weight + ' × ' + s.reps : '缺少数据',
				top: p.topSets.length > 0 && p.topSets[0].weight == s.weight && p.topSets[0].reps == s.reps
			} as SetChip)
		}
		return out
	})

	function persist() {
		// 保存原始 prefs.metric（可能是 '' 自动默认），不保存解析后的 metric
		const saved = { exerciseId: prefs.value.exerciseId, metric: prefs.value.metric, rangeDays: rangeDaysValue.value } as InsightPrefs
		saveInsightPrefs(saved)
	}

	function setMetric(m : string) {
		prefs.value.metric = m
		selectedKey.value = ''
		persist()
	}

	function openPicker() {
		emit('open-picker', { options: options.value, selectedId: exerciseId.value })
	}

	function onSelectExercise(id : string) {
		prefs.value.exerciseId = id
		selectedKey.value = ''
		// 重置为自动默认（''），由 metric computed 按动作类型解析
		prefs.value.metric = ''
		persist()
	}

	function closeDetail() {
		selectedKey.value = ''
	}

	function refreshPrefs() {
		// loadInsightPrefs 返回已 sanitize 的值，直接采用（metric 可为 '' 自动默认）
		prefs.value = loadInsightPrefs()
	}

	// -------- Canvas 绘制 --------
	// setup 顶层捕获组件实例（回调里临时调 getCurrentInstance() 会拿到 null）
	const instance = getCurrentInstance()

	// 用与描边相同的曲线方式 trace 一遍（二次贝塞尔平滑），填充/描边共用
	function traceCurve(ctx : any, cdps : ChartDataPoint[]) {
		ctx.moveTo(cdps[0].x, cdps[0].y)
		if (cdps.length >= 3) {
			for (let i = 1; i < cdps.length - 1; i++) {
				const prev = cdps[i - 1]
				const cur = cdps[i]
				const cpX = (prev.x + cur.x) / 2
				const cpY = (prev.y + cur.y) / 2
				ctx.quadraticCurveTo(cpX, cpY, cur.x, cur.y)
			}
			// 最后一段
			const last = cdps[cdps.length - 1]
			const prevLast = cdps[cdps.length - 2]
			const cpX = (prevLast.x + last.x) / 2
			const cpY = (prevLast.y + last.y) / 2
			ctx.quadraticCurveTo(cpX, cpY, last.x, last.y)
		} else {
			// 2 个点：直线
			for (let i = 1; i < cdps.length; i++) {
				ctx.lineTo(cdps[i].x, cdps[i].y)
			}
		}
	}

	function drawChart() {
		if (!canvasReady.value) return
		if (instance == null) return
		const pts = trend.value.points
		const query = uni.createSelectorQuery().in((instance as any).proxy)
		query.select('#pfChart').fields({ node: true, size: true }).exec((res) => {
			if (res == null || res[0] == null) return
			const canvas = res[0].node
			const ctx = canvas.getContext('2d')
			const dpr = uni.getSystemInfoSync().pixelRatio
			const cssW = res[0].width
			if (cssW <= 0) return
			const cssH = CHART_PLOT_HEIGHT
			canvas.width = cssW * dpr
			canvas.height = cssH * dpr
			ctx.scale(dpr, dpr)
			ctx.clearRect(0, 0, cssW, cssH)

			if (pts.length == 0) return

			const plotW = cssW - CHART_PADDING_LEFT - CHART_PADDING_RIGHT
			const plotH = CHART_PLOT_HEIGHT - CHART_PADDING_TOP - CHART_PADDING_BOTTOM
			const axisMin = trend.value.axisMin
			const axisMax = trend.value.axisMax
			let span = axisMax - axisMin
			if (span <= 0) span = 1
			const zeroY = CHART_PADDING_TOP + plotH

			// 计算每个点的坐标（按 axisMin~axisMax 映射）
			const cdps : ChartDataPoint[] = []
			for (let i = 0; i < pts.length; i++) {
				const x = pts.length == 1 ? cssW / 2 : CHART_PADDING_LEFT + (plotW * i) / (pts.length - 1)
				const ratio = (pts[i].value - axisMin) / span
				const y = zeroY - ratio * plotH
				cdps.push({ x: x, y: y, index: i } as ChartDataPoint)
			}
			chartDataPoints.value = cdps

			// 画网格线（仅顶部和中间）
			ctx.strokeStyle = '#eef1ef'
			ctx.lineWidth = 0.5
			ctx.beginPath()
			ctx.moveTo(CHART_PADDING_LEFT, CHART_PADDING_TOP)
			ctx.lineTo(cssW - CHART_PADDING_RIGHT, CHART_PADDING_TOP)
			ctx.moveTo(CHART_PADDING_LEFT, CHART_PADDING_TOP + plotH / 2)
			ctx.lineTo(cssW - CHART_PADDING_RIGHT, CHART_PADDING_TOP + plotH / 2)
			ctx.stroke()
			// 底部基线
			ctx.strokeStyle = '#dfe5e1'
			ctx.beginPath()
			ctx.moveTo(CHART_PADDING_LEFT, zeroY)
			ctx.lineTo(cssW - CHART_PADDING_RIGHT, zeroY)
			ctx.stroke()

			// 填充 + 描边仅在 >= 2 个点时执行；单点只画圆点
			if (cdps.length >= 2) {
				// 渐变填充：直接在 ctx 上重画完整闭合路径（微信 canvas 2d 不支持 Path2D）
				const grad = ctx.createLinearGradient(0, CHART_PADDING_TOP, 0, zeroY)
				grad.addColorStop(0, 'rgba(28, 175, 115, 0.3)')
				grad.addColorStop(1, 'rgba(28, 175, 115, 0.05)')
				ctx.beginPath()
				traceCurve(ctx, cdps)
				ctx.lineTo(cdps[cdps.length - 1].x, zeroY)
				ctx.lineTo(cdps[0].x, zeroY)
				ctx.closePath()
				ctx.fillStyle = grad
				ctx.fill()

				// 画线：重新 beginPath 再 trace 一遍曲线
				ctx.beginPath()
				traceCurve(ctx, cdps)
				ctx.strokeStyle = '#1caf73'
				ctx.lineWidth = 2
				ctx.stroke()
			}

			// 画数据点（小实心圆）
			for (let i = 0; i < cdps.length; i++) {
				const p = cdps[i]
				const isSelected = pts[i].key == selectedKey.value
				const isLast = i == cdps.length - 1
				if (isLast) {
					// 最后点：大空心圆
					ctx.beginPath()
					ctx.arc(p.x, p.y, 5, 0, Math.PI * 2)
					ctx.fillStyle = '#ffffff'
					ctx.fill()
					ctx.strokeStyle = '#1caf73'
					ctx.lineWidth = 2
					ctx.stroke()
				} else {
					// 普通点：小实心
					ctx.beginPath()
					ctx.arc(p.x, p.y, isSelected ? 4 : 2.5, 0, Math.PI * 2)
					ctx.fillStyle = isSelected ? '#1caf73' : '#ffffff'
					ctx.fill()
					ctx.strokeStyle = '#1caf73'
					ctx.lineWidth = 1.5
					ctx.stroke()
				}
			}

			// PR 标记：找历史最大值位置
			if (pts.length >= 2) {
				let maxIdx = 0
				for (let i = 1; i < pts.length; i++) {
					if (pts[i].value > pts[maxIdx].value) maxIdx = i
				}
				if (maxIdx > 0) {
					const prPoint = cdps[maxIdx]
					ctx.save()
					// 红星
					ctx.fillStyle = '#e4432e'
					const starSize = 5
					ctx.beginPath()
					const cx = prPoint.x
					const cy = prPoint.y - 14
					// 画五角星
					for (let i = 0; i < 5; i++) {
						const outerAngle = -Math.PI / 2 + i * Math.PI * 2 / 5
						const innerAngle = outerAngle + Math.PI / 5
						const ox = cx + Math.cos(outerAngle) * starSize
						const oy = cy + Math.sin(outerAngle) * starSize
						const ix = cx + Math.cos(innerAngle) * (starSize * 0.4)
						const iy = cy + Math.sin(innerAngle) * (starSize * 0.4)
						if (i == 0) ctx.moveTo(ox, oy)
						else ctx.lineTo(ox, oy)
						ctx.lineTo(ix, iy)
					}
					ctx.closePath()
					ctx.fill()
					ctx.restore()
				}
			}
		})
	}

	function onCanvasTap(e : any) {
		const detail = (e as any).detail
		if (detail == null) return
		const tapX = detail.x
		const tapY = detail.y
		const cdps = chartDataPoints.value
		if (cdps.length == 0) return
		// 找最近的点（x 距离）
		let nearest = 0
		let minDist = Math.abs(tapX - cdps[0].x)
		for (let i = 1; i < cdps.length; i++) {
			const d = Math.abs(tapX - cdps[i].x)
			if (d < minDist) { minDist = d; nearest = i }
		}
		// 必须在合理范围内（x 距离 < 15）
		if (minDist > 15) return
		const pts = trend.value.points
		selectedKey.value = pts[nearest].key == selectedKey.value ? '' : pts[nearest].key
	}

	// 监听数据变化重绘
	watch(() => trend.value, () => {
		if (!canvasReady.value) return
		nextTick(() => { drawChart() })
	}, { deep: true })

	function measureChart() {
		canvasReady.value = true
		nextTick(() => { drawChart() })
	}

	onMounted(() => {
		refreshPrefs()
		uni.$on('exercise-performance-pick', onSelectExercise)
		uni.$on('workout-saved', refreshPrefs)
		// 等布局完成再测尺寸
		setTimeout(() => { measureChart() }, 100)
	})

	onUnmounted(() => {
		uni.$off('exercise-performance-pick', onSelectExercise)
		uni.$off('workout-saved', refreshPrefs)
	})
</script>

<style lang="scss">
	@import "@/styles/analytics-card.scss";

	.pf-select {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		height: 44px;
		padding: 0 14px;
		border-width: 1px;
		border-style: solid;
		border-color: #e3e8e5;
		border-radius: 13px;
		background-color: #fbfcfb;
	}

	.pf-select-name {
		flex: 1;
		min-width: 0;
		color: #1f2a24;
		font-size: 16px;
		font-weight: 600;
		white-space: nowrap;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	.pf-select-arrow {
		margin-left: 8px;
		color: #7d8982;
		font-size: 14px;
	}

	.pf-metrics {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-top: 10px;
	}

	.pf-chip {
		flex: 1;
		margin-right: 8px;
		padding: 7px 0;
		border-width: 1px;
		border-style: solid;
		border-color: #e4e9e6;
		border-radius: 10px;
		color: #717c76;
		background-color: #ffffff;
		font-size: 13px;
		text-align: center;
	}

	.pf-chip.active {
		border-color: #1caa70;
		color: #ffffff;
		background-color: #1caf73;
		font-weight: 600;
	}

	.pf-empty {
		display: block;
		margin-top: 14px;
		padding: 20px 14px;
		border-width: 1px;
		border-style: dashed;
		border-color: #d9dfdb;
		border-radius: 16px;
		color: #8d9691;
		font-size: 13px;
		line-height: 1.6;
		text-align: center;
	}

	.pf-head {
		display: flex;
		flex-direction: row;
		align-items: baseline;
		margin-top: 16px;
	}

	.pf-head-value {
		margin-right: 6px;
		color: #1f2a24;
