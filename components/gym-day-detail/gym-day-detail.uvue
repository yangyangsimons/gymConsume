		line-height: 1.6;
	}

	.dd-no-detail {
		display: block;
		margin-top: 14px;
		color: #a0aaa4;
		font-size: 12px;
	}

	.dd-ex {
		margin-top: 14px;
		padding-top: 14px;
		border-top-width: 1px;
		border-top-style: solid;
		border-top-color: #eef1ef;
	}

	.dd-ex-top {
		display: flex;
		flex-direction: row;
