		border-style: solid;
		border-color: #e9edea;
		border-radius: 18px;
		background-color: #ffffff;
	}

	.dd-entry-head {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.dd-entry-title {
		color: #1f2a24;
		font-size: 17px;
		font-weight: 700;
	}

	.dd-tag {
		margin-left: 8px;
		padding: 2px 8px;
		border-radius: 7px;
		color: #318463;
		background-color: #edf8f3;
		font-size: 11px;
	}

	.dd-tag.tag-active {
		color: #a35f0f;
		background-color: #fdf0dc;
	}

	.dd-tag.tag-warn {
		color: #b5483f;
		background-color: #fceceb;
	}

	.dd-stats {
		display: flex;
		flex-direction: row;
		margin-top: 14px;
	}

	.dd-stat {
		flex: 1;
	}

	.dd-stat-value {
		display: block;
		color: #159b65;
		font-size: 22px;
		font-weight: 700;
	}

	.dd-stat-label {
		display: block;
		margin-top: 4px;
