<template>
	<view class="sheet-backdrop" @click="onBackdropClick">
		<view class="workout-sheet" @click.stop="noop">
			<view class="sheet-handle"></view>
			<view class="sheet-header">
				<view>
					<text class="section-kicker">{{ step === 'select' ? 'NEW WORKOUT' : 'TRAINING LOG' }}</text>
					<text class="sheet-title">{{ step === 'select' ? '添加训练动作' : selectedName }}</text>
				</view>
				<button class="close-button" @click="onClose">
					<gym-icon name="close-muted" :size="18"></gym-icon>
				</button>
			</view>

			<view class="step-select" v-if="step === 'select'">
				<view class="search-box">
					<gym-icon name="search-muted-light" :size="19"></gym-icon>
					<input class="search-input" placeholder="搜索动作名称或拼音" :value="keyword" @input="onSearchInput" />
				</view>
				<scroll-view class="category-tabs" scroll-x="true">
					<button class="category-btn" :class="{ active: category === item }" v-for="item in categories"
						:key="item" @click="category = item">{{ item }}</button>
				</scroll-view>
				<view class="exercise-list">
					<text class="exercise-empty" v-if="loadingExercises">加载中…</text>
					<text class="exercise-empty" v-else-if="filteredExercises.length === 0">没有找到动作</text>
					<button class="exercise-item" :class="{ 'no-border': idx === filteredExercises.length - 1 }"
						v-for="(exercise, idx) in filteredExercises" :key="exercise._id" @click="selectExercise(exercise)">
						<view class="exercise-thumb" :class="'thumb-' + idx">{{ exercise.icon }}</view>
						<view class="exercise-copy">
							<text class="exercise-name">{{ exercise.name }}</text>
							<text class="exercise-sub">{{ exercise.sub }}</text>
						</view>
						<gym-icon name="chevron-muted-light" :size="18"></gym-icon>
					</button>
				</view>
				<button class="custom-exercise">
					<gym-icon name="plus-brand" :size="18"></gym-icon>
					<text>创建自定义动作</text>
				</button>
			</view>
			<view class="step-entry" v-else>
				<view class="exercise-summary">
					<view class="exercise-illustration">
						<gym-icon name="dumbbell-brand" :size="36"></gym-icon>
					</view>
					<view class="exercise-summary-copy">
						<text class="exercise-summary-sub">{{ selectedSub }}</text>
						<text class="exercise-summary-strong">{{ bestLabel }}</text>
					</view>
					<button class="exercise-summary-btn" @click="step = 'select'">换动作</button>
				</view>
				<view class="sets-header">
					<text class="col-number">组</text>
					<text class="col-last">上次</text>
					<text class="col-weight">重量 kg</text>
					<text class="col-reps">次数</text>
					<text class="col-check"></text>
				</view>
				<view class="sets-list">
					<view class="set-row" :class="{ completed: set.done }" v-for="(set, i) in sets" :key="i">
						<text class="set-number">{{ i + 1 }}</text>
						<text class="last-set">{{ lastSetLabel(i) }}</text>
						<input class="set-input" type="digit" :value="set.weight" placeholder="0"
							@input="onWeightInput(i, $event)" />
						<input class="set-input" type="number" :value="set.reps" placeholder="0"
							@input="onRepsInput(i, $event)" />
						<button class="set-check" @click="toggleSet(i)">
							<gym-icon name="check-white" :size="18" v-if="set.done"></gym-icon>
						</button>
					</view>
				</view>
				<button class="add-set" @click="addSet">
					<gym-icon name="plus-brand" :size="18"></gym-icon>
					<text>添加一组</text>
				</button>
				<view class="rest-row">
					<view class="rest-label">
						<gym-icon name="clock-muted" :size="18"></gym-icon>
						<text>组间休息</text>
					</view>
					<text class="rest-value">01:30</text>
					<button class="rest-btn">开始计时</button>
				</view>
				<button class="save-workout" :disabled="saving" @click="onSave">{{ saving ? '保存中…' : '完成并保存' }}</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { Exercise, SetLog, Workout, bestSetOf, lastSetsOf } from '@/services/gym-stats.uts'
	import { loadExercises, loadWorkouts, saveExerciseLog } from '@/services/gym-api.uts'

	type WorkoutSet = {
		weight : string
		reps : string
		done : boolean
	}

	type InputEventDetail = {
		value : string
	}
	type InputEvent = {
		detail : InputEventDetail
	}

	const emit = defineEmits(['close'])

	const openedAt = Date.now()
	const step = ref<string>('select')
	const category = ref<string>('胸')
	const categories = ref<string[]>(['胸', '背', '腿', '肩', '手臂', '核心'])
	const keyword = ref<string>('')
	const loadingExercises = ref<boolean>(true)
	const saving = ref<boolean>(false)

	const exercises = ref<Exercise[]>([])
	const history = ref<Workout[]>([])
	const selected = ref<Exercise | null>(null)
	const selectedName = ref<string>('')
	const selectedSub = ref<string>('')
	const bestLabel = ref<string>('')
	const lastSets = ref<SetLog[]>([])

	const sets = ref<WorkoutSet[]>([])

	const filteredExercises = computed(() : Exercise[] => {
		const kw = keyword.value.trim().toLowerCase()
		return exercises.value.filter((e : Exercise) : boolean => {
			if (kw.length > 0) return e.name.includes(kw) || e.pinyin.includes(kw)
			return e.category == category.value
		})
	})

	onMounted(() => {
		loadExercises().then((list : Exercise[]) => {
			exercises.value = list
			loadingExercises.value = false
		}).catch(() => {
			loadingExercises.value = false
			uni.showToast({ title: '动作库加载失败', icon: 'none' })
		})
		loadWorkouts().then((list : Workout[]) => {
			history.value = list
		}).catch(() => { })
	})

	function newSets() : WorkoutSet[] {
		return [
			{ weight: '', reps: '', done: false } as WorkoutSet,
			{ weight: '', reps: '', done: false } as WorkoutSet,
			{ weight: '', reps: '', done: false } as WorkoutSet
		]
	}

	function onSearchInput(e : InputEvent) {
		keyword.value = e.detail.value
	}

	function selectExercise(exercise : Exercise) {
		selected.value = exercise
		selectedName.value = exercise.name
		selectedSub.value = exercise.sub
		lastSets.value = lastSetsOf(history.value, exercise._id)
		const best = bestSetOf(history.value, exercise._id)
		bestLabel.value = best == null ? '还没有历史记录' : '历史最佳 ' + best.weight + ' kg × ' + best.reps
		sets.value = newSets()
		step.value = 'entry'
	}

	function lastSetLabel(i : number) : string {
		if (i < lastSets.value.length) return lastSets.value[i].weight + ' × ' + lastSets.value[i].reps
		return '—'
	}

	function updateSet(index : number, key : string, value : string) {
		const set = sets.value[index]
		if (key == 'weight') {
			set.weight = value
		} else {
			set.reps = value
		}
	}

	function onWeightInput(index : number, e : InputEvent) {
		updateSet(index, 'weight', e.detail.value)
	}

	function onRepsInput(index : number, e : InputEvent) {
		updateSet(index, 'reps', e.detail.value)
	}

	function toggleSet(index : number) {
		sets.value[index].done = !sets.value[index].done
	}

	function addSet() {
		sets.value.push({ weight: '', reps: '', done: false } as WorkoutSet)
	}

	async function onSave() {
		const exercise = selected.value
		if (exercise == null || saving.value) return
		const logs : SetLog[] = []
		for (let i = 0; i < sets.value.length; i++) {
			const s = sets.value[i]
			const weight = s.weight == '' ? 0 : parseFloat(s.weight)
			const reps = parseInt(s.reps)
			if (s.done && !isNaN(weight) && !isNaN(reps) && reps > 0) {
				logs.push({ weight: weight, reps: reps, done: true } as SetLog)
			}
		}
		if (logs.length == 0) {
			uni.showToast({ title: '请填写并勾选至少一组', icon: 'none' })
			return
		}
		saving.value = true
		try {
			const minutes = Math.max(1, Math.round((Date.now() - openedAt) / 60000))
			await saveExerciseLog({
				exerciseId: exercise._id,
				name: exercise.name,
				category: exercise.category,
				sets: logs
			}, minutes)
			uni.$emit('workout-saved')
			uni.showToast({ title: '已保存', icon: 'none' })
			emit('close')
		} catch (e) {
			uni.showToast({ title: '保存失败，请重试', icon: 'none' })
		}
		saving.value = false
	}

	function onClose() {
		emit('close')
	}

	function onBackdropClick() {
		emit('close')
	}

	function noop() {
		// 阻止点击弹层内容时冒泡到背景层
	}
</script>

