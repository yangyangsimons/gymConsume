<template>
	<view class="sheet-backdrop" @click="requestClose">
		<view class="workout-sheet" @click.stop="noop">
			<view class="sheet-handle"></view>
			<view class="sheet-header">
				<view class="sheet-header-copy">
					<text class="section-kicker">{{ step === 'select' ? 'NEW WORKOUT' : 'TRAINING LOG' }}</text>
					<text class="sheet-title">{{ step === 'select' ? '添加训练动作' : workTitle }}</text>
				</view>
				<button class="close-button" @click="requestClose">
					<gym-icon name="close-muted" :size="18"></gym-icon>
				</button>
			</view>

			<scroll-view class="sheet-body" scroll-y="true" v-if="step === 'select'">
				<view class="search-box">
					<gym-icon name="search-muted-light" :size="19"></gym-icon>
					<input class="search-input" placeholder="搜索动作名称或拼音" :value="keyword" @input="onSearchInput" />
				</view>
				<scroll-view class="category-tabs" scroll-x="true">
					<button class="category-btn" :class="{ active: category === item }" v-for="item in categories"
						:key="item" @click="category = item">{{ item }}</button>
				</scroll-view>
				<view class="exercise-list">
					<text class="exercise-empty" v-if="loadingExercises">加载中…</text>
					<text class="exercise-empty" v-else-if="filteredExercises.length === 0">没有找到动作</text>
					<button class="exercise-item" :class="{ 'no-border': idx === filteredExercises.length - 1 }"
						v-for="(exercise, idx) in filteredExercises" :key="exercise._id" @click="selectExercise(exercise)">
						<view class="exercise-thumb" :class="'thumb-' + idx">{{ exercise.icon }}</view>
						<view class="exercise-copy">
							<text class="exercise-name">{{ exercise.name }}</text>
							<text class="exercise-sub">{{ exercise.sub }}</text>
						</view>
						<gym-icon name="chevron-muted-light" :size="18"></gym-icon>
					</button>
				</view>
				<button class="custom-exercise">
					<gym-icon name="plus-brand" :size="18"></gym-icon>
					<text>创建自定义动作</text>
				</button>
				<view class="body-pad"></view>
			</scroll-view>

			<scroll-view class="sheet-body" scroll-y="true" v-else>
				<view class="exercise-summary">
					<view class="summary-top">
						<view class="exercise-illustration">
							<gym-icon name="dumbbell-brand" :size="30"></gym-icon>
						</view>
						<view class="summary-copy">
							<text class="summary-target">{{ targetLabel }}</text>
							<text class="summary-progress">{{ progressLabel }}</text>
						</view>
					</view>
					<view class="summary-actions">
						<button class="summary-btn primary" @click="showTarget = true">编辑目标</button>
						<button class="summary-btn" @click="step = 'select'">换动作</button>
					</view>
				</view>

				<view class="sets-header">
					<text class="sets-title">训练记录</text>
					<button class="rir-help-btn" @click="showRirHelp">什么是 RIR？</button>
				</view>
				<view class="sets-list">
					<view class="set-card" :class="{ completed: row.done, warmup: row.warm }" v-for="row in rows"
						:key="row.id">
						<view class="set-top">
							<text class="set-badge">{{ row.badge }}</text>
							<view class="kind-switch">
								<button class="kind-btn" :class="{ active: !row.warm }" @click="setKind(row.id, 'work')">正式</button>
								<button class="kind-btn" :class="{ active: row.warm }" @click="setKind(row.id, 'warmup')">热身</button>
							</view>
							<view class="set-top-spacer"></view>
							<button class="set-delete" @click="removeSet(row.id)">
								<gym-icon name="close-muted" :size="16"></gym-icon>
							</button>
							<button class="set-check" :class="{ checked: row.done }" @click="toggleDone(row.id)">
								<gym-icon name="check-white" :size="20" v-if="row.done"></gym-icon>
							</button>
						</view>
						<view class="set-fields">
							<view class="field field-weight">
								<input class="field-input" type="digit" confirm-type="done" :value="row.weight"
									:placeholder="weightPlaceholder" @input="onWeightInput(row.id, $event)" />
								<text class="field-unit">kg</text>
							</view>
							<view class="field field-reps">
								<input class="field-input" type="number" confirm-type="done" :value="row.reps" placeholder="次数"
									@input="onRepsInput(row.id, $event)" />
								<text class="field-unit">次</text>
							</view>
							<button class="rir-field" :class="{ filled: row.rirSet }" @click="openRir(row.id)">
								<text class="rir-caption">RIR</text>
								<text class="rir-value">{{ row.rirText }}</text>
							</button>
						</view>
						<text class="set-last" v-if="row.last !== ''">{{ row.last }}</text>
						<text class="set-error" v-if="errorSetId === row.id">{{ errorText }}</text>
					</view>
				</view>
				<button class="add-set" @click="addSet">
					<gym-icon name="plus-brand" :size="18"></gym-icon>
					<text>添加一组</text>
				</button>
				<view class="rest-row">
					<view class="rest-top">
						<view class="rest-label">
							<gym-icon name="clock-muted" :size="20"></gym-icon>
							<text class="rest-label-text">组间休息</text>
						</view>
						<button class="rest-btn" :class="{ running: restRunning }" @click="toggleRest">{{ restRunning ? '停止' : '开始计时' }}</button>
					</view>
					<view class="rest-adjust">
						<button class="rest-step" :disabled="restRunning" @click="adjustRest(-15)">−</button>
						<text class="rest-value" :class="{ running: restRunning }">{{ formatTime(restRunning ? restRemaining : restSeconds) }}</text>
						<button class="rest-step" :disabled="restRunning" @click="adjustRest(15)">+</button>
					</view>
				</view>
				<view class="body-pad"></view>
			</scroll-view>

			<view class="sheet-footer" v-if="step === 'entry'">
				<button class="save-workout" @click="onSave">保存动作</button>
				<text class="save-hint">保存到本机并返回本次训练，不会结束整场训练</text>
				<view class="safe-bottom"></view>
			</view>
		</view>

		<gym-rir-picker v-if="showRir" :value="rirValue" :set-label="rirSetLabel" @select="onRirSelect"
			@close="showRir = false"></gym-rir-picker>
		<gym-target-editor v-if="showTarget && work != null" :target="work.target" @save="onTargetSave"
			@close="showTarget = false"></gym-target-editor>
	</view>
</template>

<script setup lang="uts">
	import { Exercise, SetLog, Workout, lastSetsOf } from '@/services/gym-stats.uts'
	import { loadExercises, loadWorkouts } from '@/services/gym-api.uts'
	import {
		EditingDraft, ExerciseProgress, ExerciseTarget, KIND_WARMUP, KIND_WORK, RIR_UNSET, SetEntry, SessionExercise,
		WorkoutSession, cloneExercise, exerciseProgress, formatTarget, hasInput, newSessionExercise, newSet, rirLabel,
		saveSession, startSession, validateSet
	} from '@/services/workout-session.uts'
	import { confirmDialog, infoDialog } from '@/services/gym-dialog.uts'

	type SetRow = {
		id : string
		badge : string
		warm : boolean
		weight : string
		reps : string
		rirText : string
		rirSet : boolean
		done : boolean
		last : string
	}

	type InputEventDetail = {
		value : string
	}
	type InputEvent = {
		detail : InputEventDetail
	}

	const RIR_HELP = '剩余次数 RIR：完成这一组后，你估计还能以相同动作标准再做几次？例如，选择 2，表示大约还能做 2 次。'

	const { editIndex = -1 } = defineProps<{
		editIndex ?: number
	}>()

	const emit = defineEmits(['close', 'saved'])

	const session : WorkoutSession = startSession()
	const step = ref<string>('select')
	const work = ref<SessionExercise | null>(null)
	let baseline = ''
	let editingIndex = -1
	let closed = false

	// 优先恢复上次未保存的编辑；否则按 editIndex 打开已有动作
	function restoreWork() {
		const draft = session.editing
		if (draft != null) {
			work.value = draft.exercise
			baseline = draft.baseline
			editingIndex = draft.index
			step.value = 'entry'
			return
		}
		if (editIndex >= 0 && editIndex < session.exercises.length) {
			const copy = cloneExercise(session.exercises[editIndex])
			work.value = copy
			baseline = JSON.stringify(copy)
			editingIndex = editIndex
			step.value = 'entry'
		}
	}
	restoreWork()

	const category = ref<string>('胸')
	const categories = ref<string[]>(['胸', '背', '腿', '肩', '手臂', '核心'])
	const keyword = ref<string>('')
	const loadingExercises = ref<boolean>(true)
	const exercises = ref<Exercise[]>([])
	const history = ref<Workout[]>([])

	const showRir = ref<boolean>(false)
	const showTarget = ref<boolean>(false)
	const rirSetId = ref<string>('')
	const rirSetLabel = ref<string>('')
	const rirValue = ref<string>('')

	const errorSetId = ref<string>('')
	const errorText = ref<string>('')

	const restSeconds = ref<number>(work.value != null ? work.value.target.restSeconds : 90)
	const restRemaining = ref<number>(restSeconds.value)
	const restRunning = ref<boolean>(false)
	let restTimer : number = -1
	let persistTimer : number = -1

	function formatTime(total : number) : string {
		const m = Math.floor(total / 60)
		const s = total % 60
		return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s
	}

	function clearRestTimer() {
		if (restTimer != -1) {
			clearInterval(restTimer)
			restTimer = -1
		}
		restRunning.value = false
	}

	function adjustRest(delta : number) {
		if (restRunning.value) return
		const next = restSeconds.value + delta
		restSeconds.value = Math.min(600, Math.max(15, next))
	}

	function toggleRest() {
		if (restRunning.value) {
			clearRestTimer()
			return
		}
		restRemaining.value = restSeconds.value
		restRunning.value = true
		restTimer = setInterval(() => {
			restRemaining.value = restRemaining.value - 1
			if (restRemaining.value <= 0) {
				clearRestTimer()
				uni.vibrateLong({})
				uni.showToast({ title: '休息结束，开始下一组', icon: 'none' })
			}
		}, 1000)
	}

	function persistNow() {
		if (closed) return
		if (persistTimer != -1) {
			clearTimeout(persistTimer)
			persistTimer = -1
		}
		const ex = work.value
		if (ex == null) return
		session.editing = { index: editingIndex, baseline: baseline, exercise: ex } as EditingDraft
		saveSession(session)
	}

	function schedulePersist() {
		if (persistTimer != -1) clearTimeout(persistTimer)
		persistTimer = setTimeout(() => {
			persistTimer = -1
			persistNow()
		}, 400)
	}

	onUnmounted(() => {
		clearRestTimer()
		if (persistTimer != -1) persistNow()
	})

	const workTitle = computed(() : string => work.value == null ? '' : work.value.name)
	const targetLabel = computed(() : string => work.value == null ? '' : formatTarget(work.value.target))
	const weightPlaceholder = computed(() : string => work.value != null && !work.value.weightRequired ? '选填' : '重量')

	const progressLabel = computed(() : string => {
		const ex = work.value
		if (ex == null) return ''
		const p : ExerciseProgress = exerciseProgress(ex)
		let text = '已完成 ' + p.workDone + '/' + p.workTarget + ' 个正式组'
		if (p.warmupTotal > 0) text += ' · 热身 ' + p.warmupDone + '/' + p.warmupTotal
		return text
	})

	const lastSets = computed(() : SetLog[] => work.value == null ? [] : lastSetsOf(history.value, work.value.exerciseId))

	function lastText(n : number) : string {
		const list = lastSets.value
		if (list.length == 0) return '上次 暂无记录'
		if (n >= list.length) return '上次 无对应组'
		const l = list[n]
		return '上次 ' + (l.weight > 0 ? l.weight + ' kg' : '自重') + ' × ' + l.reps + ' 次 · RIR 未记录'
	}

	const rows = computed(() : SetRow[] => {
		const out : SetRow[] = []
		const ex = work.value
		if (ex == null) return out
		let workNo = 0
		let warmNo = 0
		for (let i = 0; i < ex.sets.length; i++) {
			const s = ex.sets[i]
			const warm = s.kind == KIND_WARMUP
			let badge = ''
			let last = ''
			if (warm) {
				warmNo++
				badge = '热' + warmNo
			} else {
				workNo++
				badge = '' + workNo
				last = lastText(workNo - 1)
			}
			out.push({
				id: s.id,
				badge: badge,
				warm: warm,
				weight: s.weight,
				reps: s.reps,
				rirText: rirLabel(s.rir, '—'),
				rirSet: s.rir != RIR_UNSET,
				done: s.done,
				last: last
			} as SetRow)
		}
		return out
	})

	const filteredExercises = computed(() : Exercise[] => {
		const kw = keyword.value.trim().toLowerCase()
		return exercises.value.filter((e : Exercise) : boolean => {
			if (kw.length > 0) return e.name.includes(kw) || e.pinyin.includes(kw)
			return e.category == category.value
		})
	})

	onMounted(() => {
		loadExercises().then((list : Exercise[]) => {
			exercises.value = list
			loadingExercises.value = false
		}).catch(() => {
			loadingExercises.value = false
			uni.showToast({ title: '动作库加载失败', icon: 'none' })
		})
		loadWorkouts().then((list : Workout[]) => {
			history.value = list
		}).catch(() => { })
	})

	function onSearchInput(e : InputEvent) {
		keyword.value = e.detail.value
	}

	function anyInput() : boolean {
		const ex = work.value
		if (ex == null) return false
		for (let i = 0; i < ex.sets.length; i++) {
			if (hasInput(ex.sets[i])) return true
		}
		return false
	}

	async function selectExercise(exercise : Exercise) {
		const cur = work.value
		if (cur != null && cur.exerciseId == exercise._id) {
			step.value = 'entry'
			return
		}
		if (cur != null && anyInput()) {
			const ok = await confirmDialog('更换动作', '更换后，当前动作已填写的组和目标会被重置。', '更换', '取消')
			if (!ok) return
		}
		const next = newSessionExercise(exercise)
		if (cur != null && editingIndex >= 0) {
			next.id = cur.id
		} else {
			baseline = JSON.stringify(next)
		}
		work.value = next
		errorSetId.value = ''
		clearRestTimer()
		restSeconds.value = next.target.restSeconds
		restRemaining.value = next.target.restSeconds
		step.value = 'entry'
		persistNow()
	}

	function findSet(id : string) : SetEntry | null {
		const ex = work.value
		if (ex == null) return null
		for (let i = 0; i < ex.sets.length; i++) {
			if (ex.sets[i].id == id) return ex.sets[i]
		}
		return null
	}

	function clearError(id : string) {
		if (errorSetId.value == id) errorSetId.value = ''
	}

	function onWeightInput(id : string, e : InputEvent) {
		const s = findSet(id)
		if (s == null) return
		s.weight = e.detail.value
		clearError(id)
		schedulePersist()
	}

	function onRepsInput(id : string, e : InputEvent) {
		const s = findSet(id)
		if (s == null) return
		s.reps = e.detail.value
		clearError(id)
		schedulePersist()
	}

	function setKind(id : string, kind : string) {
		const s = findSet(id)
		if (s == null || s.kind == kind) return
		s.kind = kind
		persistNow()
	}

	function toggleDone(id : string) {
		const ex = work.value
		const s = findSet(id)
		if (ex == null || s == null) return
		if (s.done) {
			s.done = false
			clearError(id)
		} else {
			const msg = validateSet(s, ex.weightRequired)
			if (msg != '') {
				errorSetId.value = id
				errorText.value = msg
				return
			}
			s.done = true
			clearError(id)
		}
		persistNow()
	}

	function addSet() {
		const ex = work.value
		if (ex == null) return
		ex.sets.push(newSet(KIND_WORK))
		persistNow()
	}

	async function removeSet(id : string) {
		const ex = work.value
		const s = findSet(id)
		if (ex == null || s == null) return
		if (hasInput(s)) {
			const ok = await confirmDialog('删除这一组', '这一组已有填写内容或已完成，删除后无法恢复。', '删除', '取消')
			if (!ok) return
		}
		const idx = ex.sets.findIndex((item : SetEntry) : boolean => item.id == id)
		if (idx < 0) return
		ex.sets.splice(idx, 1)
		clearError(id)
		persistNow()
	}

	function openRir(id : string) {
		const s = findSet(id)
		if (s == null) return
		let label = ''
		for (let i = 0; i < rows.value.length; i++) {
			if (rows.value[i].id == id) label = rows.value[i].badge
		}
		rirSetId.value = id
		rirSetLabel.value = label
		rirValue.value = s.rir
		showRir.value = true
	}

	function onRirSelect(code : string) {
		const s = findSet(rirSetId.value)
		if (s != null) {
			s.rir = code
			persistNow()
		}
		showRir.value = false
	}

	function showRirHelp() {
		infoDialog('什么是 RIR？', RIR_HELP + '\n\nRIR 为选填，不填也可以完成这一组。')
	}

	// 只替换目标，不触碰已有组的任何字段
	function onTargetSave(target : ExerciseTarget) {
		const ex = work.value
		if (ex == null) return
		ex.target = target
		if (!restRunning.value) {
			restSeconds.value = target.restSeconds
			restRemaining.value = target.restSeconds
		}
		showTarget.value = false
		persistNow()
		uni.showToast({ title: '目标已更新（仅本次训练）', icon: 'none' })
	}

	function onSave() {
		const ex = work.value
		if (ex == null) return
		for (let i = 0; i < ex.sets.length; i++) {
			const s = ex.sets[i]
			if (!s.done) continue
			const msg = validateSet(s, ex.weightRequired)
			if (msg != '') {
				errorSetId.value = s.id
				errorText.value = msg + '（该组已标记完成，请补全或取消完成）'
				uni.showToast({ title: '有已完成的组数据不完整', icon: 'none' })
				return
			}
		}
		const copy = cloneExercise(ex)
		if (editingIndex >= 0 && editingIndex < session.exercises.length) {
			session.exercises[editingIndex] = copy
		} else {
			session.exercises.push(copy)
		}
		session.editing = null
		if (!saveSession(session)) {
			uni.showToast({ title: '本机保存失败，请重试', icon: 'none' })
			return
		}
		closed = true
		uni.showToast({ title: '已保存到本机', icon: 'none' })
		emit('saved')
	}

	function isDirty() : boolean {
		const ex = work.value
		return ex != null && JSON.stringify(ex) != baseline
	}

	async function requestClose() {
		if (showRir.value || showTarget.value) return
		if (isDirty()) {
			const discard = await confirmDialog('放弃修改？', '当前动作有未保存的修改，离开后将丢失。', '放弃', '继续编辑')
			if (!discard) return
		}
		closed = true
		if (persistTimer != -1) {
			clearTimeout(persistTimer)
			persistTimer = -1
		}
		session.editing = null
		saveSession(session)
		emit('close')
	}

	function noop() {
		// 阻止点击弹层内容时冒泡到背景层
	}
</script>

<style lang="scss">
	.sheet-backdrop {
		position: fixed;
		z-index: 20;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		background-color: #13251ccc;
	}

	.workout-sheet {
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 92%;
		padding: 9px 22px 0;
		border-radius: 28px 28px 0 0;
		background-color: #f8faf8;
	}

	.sheet-handle {
		width: 38px;
		height: 14px;
		margin: 0 auto 14px;
		border-radius: 2px;
		background-color: #d5dbd7;
	}

	.sheet-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.sheet-header-copy {
		flex: 1;
		margin-right: 12px;
	}

	.section-kicker {
		display: block;
		margin-bottom: 6px;
		color: #7d8982;
		font-size: 13px;
		font-weight: 700;
	}

	.sheet-title {
		display: block;
		font-size: 22px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.close-button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-width: 0;
		border-radius: 18px;
		background-color: #e9edea;
	}

	.sheet-body {
		flex: 1;
		height: 0;
	}

	.body-pad {
		height: 20px;
	}

	.search-box {
		display: flex;
		flex-direction: row;
		align-items: center;
		height: 45px;
		margin-top: 20px;
		padding: 0 13px;
		border-width: 1px;
		border-style: solid;
		border-color: #e3e8e5;
		border-radius: 13px;
		background-color: #ffffff;
	}

	.search-input {
		flex: 1;
		margin-left: 9px;
		font-size: 15px;
	}

	.category-tabs {
		display: flex;
