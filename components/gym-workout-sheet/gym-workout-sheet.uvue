<template>
	<view class="sheet-backdrop" @click="onBackdropClick">
		<view class="workout-sheet" @click.stop="noop">
			<view class="sheet-handle"></view>
			<view class="sheet-header">
				<view>
					<text class="section-kicker">{{ step === 'select' ? 'NEW WORKOUT' : 'PUSH DAY' }}</text>
					<text class="sheet-title">{{ step === 'select' ? '添加训练动作' : '杠铃卧推' }}</text>
				</view>
				<button class="close-button" @click="onClose">
					<gym-icon name="close-muted" :size="18"></gym-icon>
				</button>
			</view>

			<view class="step-select" v-if="step === 'select'">
				<view class="search-box">
					<gym-icon name="search-muted-light" :size="19"></gym-icon>
					<input class="search-input" placeholder="搜索动作名称或拼音" />
				</view>
				<scroll-view class="category-tabs" scroll-x="true">
					<button class="category-btn" :class="{ active: category === item }" v-for="item in categories"
						:key="item" @click="category = item">{{ item }}</button>
				</scroll-view>
				<view class="exercise-list">
					<button class="exercise-item" :class="{ 'no-border': idx === exercises.length - 1 }"
						v-for="(exercise, idx) in exercises" :key="exercise.name" @click="step = 'entry'">
						<view class="exercise-thumb" :class="'thumb-' + idx">{{ exercise.icon }}</view>
						<view class="exercise-copy">
							<text class="exercise-name">{{ exercise.name }}</text>
							<text class="exercise-sub">{{ exercise.sub }}</text>
						</view>
						<text class="exercise-tag" v-if="idx === 0">常用</text>
						<gym-icon name="chevron-muted-light" :size="18"></gym-icon>
					</button>
				</view>
				<button class="custom-exercise">
					<gym-icon name="plus-brand" :size="18"></gym-icon>
					<text>创建自定义动作</text>
				</button>
			</view>
			<view class="step-entry" v-else>
				<view class="exercise-summary">
					<view class="exercise-illustration">
						<gym-icon name="dumbbell-brand" :size="36"></gym-icon>
					</view>
					<view class="exercise-summary-copy">
						<text class="exercise-summary-sub">胸大肌 · 三头肌</text>
						<text class="exercise-summary-strong">历史最佳 80 kg × 5</text>
					</view>
					<button class="exercise-summary-btn">动作说明</button>
				</view>
				<view class="sets-header">
					<text class="col-number">组</text>
					<text class="col-last">上次</text>
					<text class="col-weight">重量 kg</text>
					<text class="col-reps">次数</text>
					<text class="col-check"></text>
				</view>
				<view class="sets-list">
					<view class="set-row" :class="{ completed: set.done }" v-for="(set, i) in sets" :key="i">
						<text class="set-number">{{ i + 1 }}</text>
						<text class="last-set">{{ lastSetLabel(i) }}</text>
						<input class="set-input" type="digit" :value="set.weight" placeholder="0"
							@input="onWeightInput(i, $event)" />
						<input class="set-input" type="number" :value="set.reps" placeholder="0"
							@input="onRepsInput(i, $event)" />
						<button class="set-check" @click="toggleSet(i)">
							<gym-icon name="check-white" :size="18" v-if="set.done"></gym-icon>
						</button>
					</view>
				</view>
				<button class="add-set" @click="addSet">
					<gym-icon name="plus-brand" :size="18"></gym-icon>
					<text>添加一组</text>
				</button>
				<view class="rest-row">
					<view class="rest-label">
						<gym-icon name="clock-muted" :size="18"></gym-icon>
						<text>组间休息</text>
					</view>
					<text class="rest-value">01:30</text>
					<button class="rest-btn">开始计时</button>
				</view>
				<button class="save-workout" @click="onClose">完成并保存</button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	type WorkoutSet = {
		weight : string
		reps : string
		done : boolean
	}

	type Exercise = {
		name : string
		sub : string
		icon : string
	}

	type InputEventDetail = {
		value : string
	}
	type InputEvent = {
		detail : InputEventDetail
	}

	const emit = defineEmits(['close'])

	const step = ref<string>('select')
	const category = ref<string>('胸')
	const categories = ref<string[]>(['胸', '背', '腿', '肩', '手臂', '核心'])

	const exercises = ref<Exercise[]>([
		{ name: '杠铃卧推', sub: '胸大肌 · 三头肌', icon: '卧' } as Exercise,
		{ name: '上斜哑铃卧推', sub: '上胸 · 三角肌前束', icon: '斜' } as Exercise,
		{ name: '绳索夹胸', sub: '胸大肌', icon: '夹' } as Exercise,
		{ name: '双杠臂屈伸', sub: '下胸 · 三头肌', icon: '屈' } as Exercise
	])

	const sets = ref<WorkoutSet[]>([
		{ weight: '60', reps: '10', done: true } as WorkoutSet,
		{ weight: '65', reps: '8', done: false } as WorkoutSet,
		{ weight: '', reps: '', done: false } as WorkoutSet
	])

	function lastSetLabel(i : number) : string {
		if (i == 0) return '57.5 × 10'
		if (i == 1) return '62.5 × 8'
		return '—'
	}

	function updateSet(index : number, key : string, value : string) {
		const set = sets.value[index]
		if (key == 'weight') {
			set.weight = value
		} else {
			set.reps = value
		}
	}

	function onWeightInput(index : number, e : InputEvent) {
		updateSet(index, 'weight', e.detail.value)
	}

	function onRepsInput(index : number, e : InputEvent) {
		updateSet(index, 'reps', e.detail.value)
	}

	function toggleSet(index : number) {
		sets.value[index].done = !sets.value[index].done
	}

	function addSet() {
		sets.value.push({ weight: '', reps: '', done: false } as WorkoutSet)
	}

	function onClose() {
		emit('close')
	}

	function onBackdropClick() {
		emit('close')
	}

	function noop() {
		// 阻止点击弹层内容时冒泡到背景层
	}
</script>

<style lang="scss">
