import { Exercise, aliasExerciseId, epleyOneRepMax, exerciseCategory, exerciseType, isBodyweight, isValidStatGroup, parseDate, round1 } from './gym-stats.uts'
import { DayEntry, SOURCE_CLOUD, SOURCE_LOCAL, SetRecord, addDaysStr, weekStartOf } from './gym-calendar.uts'
import { isWeightRequired } from './workout-session.uts'
import { DEFAULT_GOAL, WeeklyGoalConfig, goalForWeek } from './weekly-goal.uts'

// 数据页（热力图 / 动作表现 / 概览 / 部位分布）的统一统计。
// 输入全部是 gym-calendar 的 DayEntry（云端 + 本机已结束训练），与首页使用同一数据源和同一“计入”规则：
// 只统计已结束且有已完成正式组的训练；热身组、未完成组、进行中训练都不参与。

export const WEIGHT_UNIT = 'kg'

// ---------------------------------------------------------------- 热力图
// 展示分档集中配置（颜色 / 组数区间 / 图例文案）。仅用于展示，不代表训练效果或质量评级。
export type HeatStep = {
	level : number
	min : number
	max : number
	color : string
	label : string
}

export const HEAT_FUTURE_BORDER = '#d5dbd7'

export const HEAT_STEPS : HeatStep[] = [
	{ level: 0, min: 0, max: 0, color: '#edf1ee', label: '0 组' } as HeatStep,
	{ level: 1, min: 1, max: 5, color: '#c8efdc', label: '1–5 组' } as HeatStep,
	{ level: 2, min: 6, max: 10, color: '#7ed5ac', label: '6–10 组' } as HeatStep,
	{ level: 3, min: 11, max: 15, color: '#38b97d', label: '11–15 组' } as HeatStep,
	{ level: 4, min: 16, max: 100000, color: '#168d59', label: '16 组及以上' } as HeatStep
]

export function heatLevel(sets : number) : number {
	for (let i = HEAT_STEPS.length - 1; i >= 0; i--) {
		if (sets >= HEAT_STEPS[i].min) return HEAT_STEPS[i].level
	}
	return 0
}

export type HeatCell = {
	date : string
	day : number
	sets : number
	level : number
	color : string
	today : boolean
	future : boolean
}

export type HeatColumn = {
	key : string
	// 该周包含某月 1 日时显示月份；第一列在不与下一列冲突时显示所在月份
	label : string
	cells : HeatCell[]
}

export type Heatmap = {
	columns : HeatColumn[]
	// 统计范围内（不含未来日期）完成的正式组数与有训练的天数
	totalSets : number
	activeDays : number
}

// 周一至周日按列排布，共 weeks 列，最后一列为本周；本周尚未到的日期标记 future
export function buildHeatmap(trained : Map<string, number>, today : string, weeks : number) : Heatmap {
	const start = addDaysStr(weekStartOf(today), -(weeks - 1) * 7)
	const columns : HeatColumn[] = []
	const hasFirst : boolean[] = []
	let totalSets = 0
	let activeDays = 0
	for (let w = 0; w < weeks; w++) {
		const cells : HeatCell[] = []
		let first = false
		let label = ''
		for (let i = 0; i < 7; i++) {
			const date = addDaysStr(start, w * 7 + i)
			const d = parseDate(date)
			const future = date > today
			const sets = future ? 0 : (trained.get(date) ?? 0)
			const level = heatLevel(sets)
			if (!future) {
				totalSets += sets
				if (sets > 0) activeDays++
			}
			if (d.getDate() == 1) {
				first = true
				label = (d.getMonth() + 1) + '月'
			}
			cells.push({
				date: date,
				day: d.getDate(),
				sets: sets,
				level: level,
				color: future ? 'transparent' : HEAT_STEPS[level].color,
				today: date == today,
				future: future
			} as HeatCell)
		}
		hasFirst.push(first)
		columns.push({ key: cells[0].date, label: label, cells: cells } as HeatColumn)
	}
	if (weeks > 1 && !hasFirst[0] && !hasFirst[1]) {
		columns[0].label = (parseDate(columns[0].cells[0].date).getMonth() + 1) + '月'
	}
	return { columns: columns, totalSets: totalSets, activeDays: activeDays } as Heatmap
}

// ---------------------------------------------------------------- 动作表现
export const METRIC_WEIGHT = 'weight'
export const METRIC_VOLUME = 'volume'
export const METRIC_E1RM = 'e1rm'
export const METRIC_MAX_REPS = 'maxReps'
export const METRIC_TOTAL_REPS = 'totalReps'

export type RangeOption = {
	days : number
	label : string
}

export const RANGE_OPTIONS : RangeOption[] = [
	{ days: 28, label: '近 4 周' } as RangeOption,
	{ days: 84, label: '近 12 周' } as RangeOption,
	{ days: 365, label: '近 1 年' } as RangeOption
]
export const DEFAULT_RANGE_DAYS = 84

export function metricLabel(metric : string) : string {
	if (metric == METRIC_E1RM) return '估算 1RM'
	if (metric == METRIC_VOLUME) return '训练容量'
	if (metric == METRIC_MAX_REPS) return '单组最多次数'
	if (metric == METRIC_TOTAL_REPS) return '总次数'
	return '最高工作重量'
}

export function metricDesc(metric : string) : string {
	if (metric == METRIC_E1RM) {
		return 'Epley 公式估算的单次最大重复重量（1RM）。取每次训练中对该动作估算值最高的一组，单位 ' + WEIGHT_UNIT + '。reps > 12 或无有效重量的组不计。'
	}
	if (metric == METRIC_VOLUME) {
		return '每次训练中该动作已完成正式组的「记录重量 × 次数」之和，单位 ' + WEIGHT_UNIT + '。按记录重量直接计算，不对哑铃单只 / 双只做换算。'
	}
	if (metric == METRIC_MAX_REPS) {
		return '每次训练中该动作单组完成的最多次数（自重动作）。'
	}
	if (metric == METRIC_TOTAL_REPS) {
		return '每次训练中该动作所有已完成正式组的次数之和（自重动作）。'
	}
	return '每次训练中该动作已完成正式组的最大记录重量，单位 ' + WEIGHT_UNIT + '。不含热身组和未完成组。'
}

// 一次训练中对某个动作的记录（云端：一条 ExerciseLog；本机：一个动作）
export type Occurrence = {
	key : string
	entryKey : string
	source : string
	exerciseId : string
	name : string
	category : string
	date : string
	at : number
	sets : SetRecord[]
}

export type OccurrenceSet = {
	items : Occurrence[]
	// 缺少动作 ID、无法可靠归属到某个动作的旧记录数（不按名称猜测）
	unlinked : number
}

export function collectOccurrences(entries : DayEntry[]) : OccurrenceSet {
	const items : Occurrence[] = []
	const rank : number[] = []
	const idx : number[] = []
	let unlinked = 0
	let counter = 0
	for (let i = 0; i < entries.length; i++) {
		const e = entries[i]
		if (!e.counted) continue
		for (let j = 0; j < e.exercises.length; j++) {
			const ex = e.exercises[j]
			if (ex.records.length == 0) continue
			if (ex.exerciseId == '') {
				unlinked++
				continue
			}
			items.push({
				key: e.key + '#' + j,
				entryKey: e.key,
				source: e.source,
				exerciseId: ex.exerciseId,
				name: ex.name,
				category: ex.category,
				date: e.date,
				at: e.at,
				sets: ex.records
			} as Occurrence)
			rank.push(e.source == SOURCE_CLOUD ? 0 : 1)
			idx.push(counter++)
		}
	}
	// 稳定排序：日期 → 云端在前 / 本机在后 → 本机按结束时间 → 原始顺序
	const order : number[] = []
	for (let i = 0; i < items.length; i++) order.push(i)
	order.sort((a : number, b : number) : number => {
		const x = items[a]
		const y = items[b]
		if (x.date != y.date) return x.date < y.date ? -1 : 1
		if (rank[a] != rank[b]) return rank[a] - rank[b]
		if (x.at != y.at) return x.at - y.at
		return idx[a] - idx[b]
	})
	const sorted : Occurrence[] = []
	for (let i = 0; i < order.length; i++) sorted.push(items[order[i]])
	return { items: sorted, unlinked: unlinked } as OccurrenceSet
}

export type TrendPoint = {
	key : string
	entryKey : string
	source : string
	date : string
	at : number
	// 同一天内该动作的第几次 / 共几次
	seq : number
	countOnDate : number
	sets : SetRecord[]
	// 参与计算的组数与被跳过的组数（重量或次数缺失 / 不合法）
	usedSets : number
	skippedSets : number
	hasValue : boolean
	maxWeight : number
	// 重量等于最高重量的全部组，按记录顺序
	topSets : SetRecord[]
	// 当前 metric 口径下的最佳组（e1rm→估算值最大组；weight→最高重量组；volume→单组容量最大组；reps 类→次数最大组），无有效组为 null
	bestSet : SetRecord | null
	volume : number
	value : number
}

function validSet(s : SetRecord) : boolean {
	return s.weight > 0 && s.reps > 0
}

export function makePoint(o : Occurrence, seq : number, countOnDate : number, metric : string, bodyweight : boolean) : TrendPoint {
	let max = 0
	let volume = 0
	let used = 0
	let maxOrm = 0
	let hasOrm = false
	let maxR = 0
	let totalReps = 0
	let ormBest : SetRecord | null = null
	let volBest : SetRecord | null = null
	let volBestValue = 0
	let repsBest : SetRecord | null = null
	for (let i = 0; i < o.sets.length; i++) {
		const s = o.sets[i]
		// reps 统计：自重纯自重组（weight=0）和辅助组（weight<0）只要 reps>0 就计入
		// 非自重仍然要求 reps>0（但非自重 weight<=0 已在 validSet 层排除）
		if (s.reps > 0) {
			if (s.reps > maxR) maxR = s.reps
			totalReps += s.reps
			if (repsBest == null || s.reps > repsBest.reps) repsBest = s
		}
		// weight / volume / e1rm 统计：必须 weight > 0 && reps > 0
		if (!validSet(s)) continue
		used++
		volume += s.weight * s.reps
		if (s.weight > max) max = s.weight
		if (volBest == null || s.weight * s.reps > volBestValue) {
			volBest = s
			volBestValue = s.weight * s.reps
		}
		// e1RM 口径：weight×(1+reps/30) 最大的一组；reps=1 时等于 weight；结果按 0.5kg 取整；无 reps 上限
		if (!bodyweight) {
			const orm = Math.round((s.reps == 1 ? s.weight : s.weight * (1 + s.reps / 30)) * 2) / 2
			if (!hasOrm || orm > maxOrm) {
				maxOrm = orm
				hasOrm = true
				ormBest = s
			}
		}
	}
	const top : SetRecord[] = []
	for (let i = 0; i < o.sets.length; i++) {
		if (validSet(o.sets[i]) && o.sets[i].weight == max) top.push(o.sets[i])
	}
	const vol = round1(volume)
	let val = 0
	if (metric == METRIC_VOLUME) val = vol
	else if (metric == METRIC_E1RM) val = hasOrm ? round1(maxOrm) : 0
	else if (metric == METRIC_MAX_REPS) val = maxR
	else if (metric == METRIC_TOTAL_REPS) val = totalReps
	else val = max
	const hasValue = metric == METRIC_MAX_REPS ? (maxR > 0) : (metric == METRIC_TOTAL_REPS ? (totalReps > 0) : (metric == METRIC_E1RM ? hasOrm : used > 0))
	let bestSet : SetRecord | null = null
	if (metric == METRIC_E1RM) bestSet = ormBest
	else if (metric == METRIC_WEIGHT) bestSet = top.length > 0 ? top[0] : null
	else if (metric == METRIC_VOLUME) bestSet = volBest
	else bestSet = repsBest
	return {
		key: o.key,
		entryKey: o.entryKey,
		source: o.source,
		date: o.date,
		at: o.at,
		seq: seq,
		countOnDate: countOnDate,
		sets: o.sets,
		usedSets: used,
		skippedSets: o.sets.length - used,
		hasValue: hasValue,
		maxWeight: max,
		topSets: top,
		bestSet: bestSet,
		volume: vol,
		value: val
	} as TrendPoint
}

// 容量公式文本，例如 “60 × 10 + 62.5 × 8 = 1100 kg”
export function volumeFormula(p : TrendPoint) : string {
	const parts : string[] = []
	for (let i = 0; i < p.sets.length; i++) {
		if (validSet(p.sets[i])) parts.push(p.sets[i].weight + ' × ' + p.sets[i].reps)
	}
	return parts.join(' + ') + ' = ' + p.volume + ' ' + WEIGHT_UNIT
}

// 纵轴刻度步长：取 1 / 2 / 2.5 / 5 × 10^n 中不小于 raw 的最小值
function niceStep(raw : number) : number {
	if (raw <= 0) return 1
	let base = 1
	while (base * 10 <= raw) base *= 10
	while (base > raw) base /= 10
	const cands : number[] = [1, 2, 2.5, 5, 10]
	for (let i = 0; i < cands.length; i++) {
		if (cands[i] * base >= raw) return cands[i] * base
	}
	return 10 * base
}

export type TrendResult = {
	// 该动作是否支持重量类指标（自重 / 核心类动作没有明确的重量口径，不支持）
	supported : boolean
	// 该动作全部历史训练次数
	total : number
	// 时间范围内可计算的数据点，按时间升序
	points : TrendPoint[]
	// 时间范围内因缺少有效重量 / 次数而无法计算的次数
	noValue : number
	axisMin : number
	axisMax : number
	ticks : number[]
	// 全部历史中的最近一次（与时间范围无关）
	last : TrendPoint | null
}

export function exerciseSupportsLoad(exerciseId : string, category : string) : boolean {
	return isWeightRequired(exerciseId, category)
}

// items 需来自 collectOccurrences（已按时间排序）；缺失值不会被当作 0 画出
export function buildTrend(items : Occurrence[], exerciseId : string, category : string, metric : string, today : string, days : number, library ?: Exercise[]) : TrendResult {
	const resolved = aliasExerciseId(exerciseId)
	const bw = library != null ? isBodyweight(exerciseId, library) : exerciseSupportsLoad(exerciseId, category) == false
	const mine : Occurrence[] = items.filter((o : Occurrence) : boolean => aliasExerciseId(o.exerciseId) == resolved)
	const perDate = new Map<string, number>()
	for (let i = 0; i < mine.length; i++) perDate.set(mine[i].date, (perDate.get(mine[i].date) ?? 0) + 1)
	const seen = new Map<string, number>()
	const from = addDaysStr(today, -(days - 1))
	const points : TrendPoint[] = []
	let noValue = 0
	let last : TrendPoint | null = null
	let maxValue = 0
	let minValue = 0
	// 自重支持 maxReps/totalReps，非自重支持 weight/volume/e1rm
	const supported = bw ? (metric == METRIC_MAX_REPS || metric == METRIC_TOTAL_REPS) : (metric == METRIC_WEIGHT || metric == METRIC_VOLUME || metric == METRIC_E1RM)
	for (let i = 0; i < mine.length; i++) {
		const o = mine[i]
		const seq = (seen.get(o.date) ?? 0) + 1
		seen.set(o.date, seq)
		const p = makePoint(o, seq, perDate.get(o.date) ?? 1, metric, bw)
		if (o.date <= today) last = p
		if (!supported || o.date < from || o.date > today) continue
		if (!p.hasValue) {
			noValue++
			continue
		}
		points.push(p)
		if (p.value > maxValue) maxValue = p.value
		if (points.length == 1 || p.value < minValue) minValue = p.value
	}
	// Y 轴不固定从 0 开始：按数据 min/max 上下各留约 10% 余量，刻度取 niceStep 整数倍；
	// 只有 1 个点（或全部相等）时以该值为中心上下各留 ±10%（值为 0 时用 0~1）
	let minRaw = 0
	let maxRaw = 1
	if (points.length > 0) {
		const span = maxValue - minValue
		if (span > 0) {
			minRaw = minValue - span * 0.1
			maxRaw = maxValue + span * 0.1
		} else if (maxValue == 0) {
			minRaw = 0
			maxRaw = 1
		} else {
			minRaw = maxValue * 0.9
			maxRaw = maxValue * 1.1
		}
	}
	const step = niceStep((maxRaw - minRaw) / 2)
	let axisMin = Math.floor(minRaw / step) * step
	if (axisMin < 0) axisMin = 0
	let axisMax = Math.ceil(maxRaw / step) * step
	if (axisMax <= axisMin) axisMax = axisMin + step * 2
	// 保证 (axisMax - axisMin) 为 step 的偶数倍，中间刻度才能落在步长整数倍上（如 2.5kg 的倍数）
	const intervals = Math.round((axisMax - axisMin) / step)
	if (intervals % 2 == 1) axisMax = axisMax + step
	return {
		supported: supported,
		total: mine.length,
		points: points,
		noValue: noValue,
		axisMin: round1(axisMin),
		axisMax: round1(axisMax),
		ticks: [round1(axisMin), round1((axisMin + axisMax) / 2), round1(axisMax)],
		last: last
	} as TrendResult
}

// ---------------------------------------------------------------- 动作选择
export type ExerciseOption = {
	id : string
	name : string
	sub : string
	category : string
	pinyin : string
	count : number
	lastDate : string
	// false：只在训练记录中出现、不在当前动作库里
	inLibrary : boolean
}

// 有记录的动作在前（最近训练日期倒序，其次次数），没有记录的保持动作库顺序；按 ID 关联，变式不合并
// 过滤掉 library 里 deprecated=true 的且历史里没有记录的动作（历史里只有 deprecated 的保留，用户可能还在练）
export function buildExerciseOptions(library : Exercise[], items : Occurrence[]) : ExerciseOption[] {
	const stat = new Map<string, ExerciseOption>()
	for (let i = 0; i < items.length; i++) {
		const o = items[i]
		const cur = stat.get(o.exerciseId)
		if (cur == null) {
			stat.set(o.exerciseId, { id: o.exerciseId, name: o.name, sub: '', category: o.category, pinyin: '', count: 1, lastDate: o.date, inLibrary: false } as ExerciseOption)
		} else {
			cur.count++
			cur.lastDate = o.date
			cur.name = o.name
		}
	}
	const withData : ExerciseOption[] = []
	const without : ExerciseOption[] = []
	const used : string[] = []
	for (let i = 0; i < library.length; i++) {
		const ex = library[i]
		const s = stat.get(ex._id)
		used.push(ex._id)
		// 跳过 deprecated=true 且历史里没有记录的
		const optCount = s == null ? 0 : s.count
		if (ex.deprecated === true && optCount == 0) continue
		const opt = {
			id: ex._id,
			name: ex.name,
			sub: ex.sub,
			category: ex.category,
			pinyin: ex.pinyin,
			count: optCount,
			lastDate: s == null ? '' : s.lastDate,
			inLibrary: true
		} as ExerciseOption
		if (opt.count > 0) withData.push(opt)
		else without.push(opt)
	}
	stat.forEach((value : ExerciseOption, key : string) => {
		if (!used.includes(key)) withData.push(value)
	})
	withData.sort((a : ExerciseOption, b : ExerciseOption) : number => {
		if (a.lastDate != b.lastDate) return a.lastDate < b.lastDate ? 1 : -1
		return b.count - a.count
	})
	return withData.concat(without)
}

export function filterExerciseOptions(options : ExerciseOption[], keyword : string) : ExerciseOption[] {
	const k = keyword.trim().toLowerCase()
	if (k == '') return options
	return options.filter((o : ExerciseOption) : boolean => {
		return o.name.toLowerCase().includes(k) || o.sub.toLowerCase().includes(k) || o.category.toLowerCase().includes(k) || o.pinyin.toLowerCase().includes(k)
	})
}

// 本地偏好：保存的动作 / 指标 / 时间范围。不合法的值回退为默认，不报错
export type InsightPrefs = {
	exerciseId : string
	metric : string
	rangeDays : number
}

// metric 用 '' 作为“自动默认”哨兵：由展示层按动作类型决定（自重→maxReps，孤立→weight，其他→e1rm）
export function defaultPrefs() : InsightPrefs {
	return { exerciseId: '', metric: '', rangeDays: DEFAULT_RANGE_DAYS } as InsightPrefs
}

export function sanitizePrefs(raw : any | null) : InsightPrefs {
	const p = defaultPrefs()
	if (raw == null) return p
	const src = raw as InsightPrefs
	if (src.exerciseId != null && ('' + src.exerciseId) != '') p.exerciseId = '' + src.exerciseId
	if (src.metric == '' || src.metric == METRIC_E1RM || src.metric == METRIC_WEIGHT || src.metric == METRIC_VOLUME || src.metric == METRIC_MAX_REPS || src.metric == METRIC_TOTAL_REPS) p.metric = src.metric
	for (let i = 0; i < RANGE_OPTIONS.length; i++) {
		if (RANGE_OPTIONS[i].days == src.rangeDays) p.rangeDays = src.rangeDays
	}
	return p
}

// 当前应展示的动作：偏好中的动作仍存在则用它；否则取最近训练过的动作；都没有则取动作库第一个
export function resolveExerciseId(options : ExerciseOption[], prefId : string) : string {
	if (prefId != '') {
		for (let i = 0; i < options.length; i++) {
			if (options[i].id == prefId) return prefId
		}
	}
	return options.length > 0 ? options[0].id : ''
}

// ---------------------------------------------------------------- 概览与部位分布
export type Overview = {
	// 近 90 天有训练的天数（与首页周 / 月口径一致）
	days : number
	tons : number
	// 近 90 天总容量（kg）与总时长（分钟），展示层再按量级换算单位
	volumeKg : number
	minutes : number
	hours : number
	avgMinutes : number
	tonsChangePct : number
	hasPrev : boolean
}

export type ValueUnit = {
	value : string
	unit : string
}

function trimZeros(n : number, digits : number) : string {
	let s = n.toFixed(digits)
	if (s.indexOf('.') >= 0) {
		while (s.endsWith('0')) s = s.substring(0, s.length - 1)
		if (s.endsWith('.')) s = s.substring(0, s.length - 1)
	}
	return s
}

// 总容量展示：不足 1000 kg 用 kg（最多 1 位小数），达到 1000 kg 才换算成吨（最多 2 位小数，去掉尾零）。只用于合计，不用于单组重量
export function formatVolume(kg : number) : ValueUnit {
	if (kg >= 1000) return { value: trimZeros(kg / 1000, 2), unit: '吨' } as ValueUnit
	return { value: trimZeros(kg, 1), unit: 'kg' } as ValueUnit
}

// 总时长展示：不足 1 小时用分钟，之后用小时（最多 1 位小数）；没有有效时长显示“—”
export function formatDuration(minutes : number) : ValueUnit {
	if (minutes <= 0) return { value: '—', unit: '' } as ValueUnit
	if (minutes < 60) return { value: '' + Math.round(minutes), unit: '分钟' } as ValueUnit
	return { value: trimZeros(minutes / 60, 1), unit: 'h' } as ValueUnit
}

export function calcOverview(entries : DayEntry[], today : string) : Overview {
	const cur0 = addDaysStr(today, -89)
	const prev0 = addDaysStr(today, -179)
	const dates : string[] = []
	let count = 0
	let volume = 0
	let minutes = 0
	let prevVolume = 0
	for (let i = 0; i < entries.length; i++) {
		const e = entries[i]
		if (!e.counted || e.date > today) continue
		if (e.date >= cur0) {
			count++
			if (!dates.includes(e.date)) dates.push(e.date)
			volume += e.volume
			minutes += e.durationMin
		} else if (e.date >= prev0) {
			prevVolume += e.volume
		}
	}
	return {
		days: dates.length,
		tons: round1(volume / 1000),
		volumeKg: round1(volume),
		minutes: minutes,
		hours: round1(minutes / 60),
		avgMinutes: count > 0 ? Math.round(minutes / count) : 0,
		tonsChangePct: prevVolume > 0 ? round1((volume - prevVolume) / prevVolume * 100) : 0,
		hasPrev: prevVolume > 0
	} as Overview
}

export type MuscleShare = {
	name : string
	percent : number
	sets : number
}

export type MuscleTypeGroups = {
	compound : number
	isolated : number
}

export type MuscleStats = {
	totalSets : number
	shares : MuscleShare[]
	typeGroups : MuscleTypeGroups
}

// 部位映射
const CATEGORY_CN_TO_EN : Record<string, string> = {
	'胸': 'chest', '胸部': 'chest',
	'背': 'back', '背部': 'back',
	'腿': 'legs', '腿部': 'legs',
	'肩': 'shoulder', '肩部': 'shoulder',
	'手臂': 'arm', '臂膀': 'arm',
	'核心': 'core'
}
const MUSCLE_GROUPS : string[] = ['chest', 'back', 'legs', 'shoulder', 'arm', 'core']
const MUSCLE_NAMES : Record<string, string> = {
	'chest': '胸部', 'back': '背部', 'legs': '腿部', 'shoulder': '肩部', 'arm': '手臂', 'core': '核心'
}

function resolveCategoryKey(category : string, exerciseId : string, library : Exercise[]) : string {
	// 先 alias 映射
	const resolved = aliasExerciseId(exerciseId)
	// 从库查 category（deprecated 的 category 可能不准，用 alias 后的 id 查）
	const libCat = exerciseCategory(resolved, library)
	let cat = libCat != '' ? libCat : category
	if (cat == null || cat == '') return 'other'
	// 中文或英文都映射
	if (CATEGORY_CN_TO_EN[cat] != null) return CATEGORY_CN_TO_EN[cat]
	if (MUSCLE_NAMES[cat] != null) return cat
	return 'other'
}

// 按部位和 type 统计正式组数；range 不传时默认近 90 天；library 用于 alias 后查 category 和 type
export function calcMuscleStats(entries : DayEntry[], today : string, range ?: string, library ?: Exercise[]) : MuscleStats {
	let since = ''
	const useRange = range != null && range != '' && range != RANGE_ALL
	if (useRange) {
		const b = calcRange(today, range!)
		since = b.cur0
	} else {
		since = addDaysStr(today, -89)
	}
	const counts : number[] = [0, 0, 0, 0, 0, 0, 0]  // chest, back, legs, shoulder, arm, core, other
	let total = 0
	let compound = 0
	let isolated = 0
	const lib : Exercise[] = library != null ? library : []
	// 复合/孤立兜底需要全量历史（不过滤 range），否则切换统计范围时 type 会变化
	const allItems = collectOccurrences(entries).items
	for (let i = 0; i < entries.length; i++) {
		const e = entries[i]
		if (!e.counted || e.date > today) continue
		if (since != '' && e.date < since) continue
		for (let j = 0; j < e.exercises.length; j++) {
			const ex = e.exercises[j]
			const key = resolveCategoryKey(ex.category, ex.exerciseId, lib)
			let slot = 6  // other
			for (let g = 0; g < MUSCLE_GROUPS.length; g++) {
				if (MUSCLE_GROUPS[g] == key) { slot = g; break }
			}
			counts[slot] += ex.workSets
			total += ex.workSets
			// type 统计
			const resolvedId = aliasExerciseId(ex.exerciseId)
			const tp = resolveExerciseTypeWithFallback(resolvedId, lib, allItems)
			if (tp == '孤立') isolated += ex.workSets
			else compound += ex.workSets
		}
	}
	// 百分比按各自组数独立四舍五入，总和允许不等于 100%，不硬凑
	const shares : MuscleShare[] = []
	for (let i = 0; i < 6; i++) {
		const percent = total > 0 ? Math.round(counts[i] / total * 100) : 0
		shares.push({ name: MUSCLE_NAMES[MUSCLE_GROUPS[i]], percent: percent, sets: counts[i] } as MuscleShare)
	}
	// “其他”只统计确实没有部位归属的动作组数；没有这类动作时不显示（不再吸收四舍五入余数）
	if (counts[6] > 0) {
		shares.push({ name: '其他', percent: total > 0 ? Math.round(counts[6] / total * 100) : 0, sets: counts[6] } as MuscleShare)
	}
	// 控制台核对：各部位组数 / 复合孤立组数 / 总组数
	console.log('[部位分布] 胸 ' + counts[0] + ' 背 ' + counts[1] + ' 腿 ' + counts[2] + ' 肩 ' + counts[3] + ' 手臂 ' + counts[4] + ' 核心 ' + counts[5] + ' 其他 ' + counts[6] + ' | 复合 ' + compound + ' 孤立 ' + isolated + ' | 总组数 ' + total)
	return {
		totalSets: total,
		shares: shares,
		typeGroups: { compound: compound, isolated: isolated } as MuscleTypeGroups
	} as MuscleStats
}

export function shortDate(date : string) : string {
	const d = parseDate(date)
	return (d.getMonth() + 1) + '月' + d.getDate() + '日'
}

export function slashDate(date : string) : string {
	const d = parseDate(date)
	return (d.getMonth() + 1) + '/' + d.getDate()
}

export function clockLabel(at : number) : string {
	if (at <= 0) return ''
	const d = new Date(at)
	const h = d.getHours()
	const m = d.getMinutes()
	return (h < 10 ? '0' + h : '' + h) + ':' + (m < 10 ? '0' + m : '' + m)
}

// ========================================================================
// 新统计层：范围 / 1RM / 训练序列 / PR / 概览对比
// 不改动上面任何已有函数；输入仍走 collectOccurrences + DayEntry
// ========================================================================

// 范围代号
export const RANGE_4W = '4w'
export const RANGE_12W = '12w'
export const RANGE_6M = '6m'
export const RANGE_ALL = 'all'

export function rangeDays(range : string) : number {
	if (range == RANGE_4W) return 28
	if (range == RANGE_12W) return 84
	if (range == RANGE_6M) return 183
	return 0  // all
}

export function rangeLabel(range : string) : string {
	if (range == RANGE_4W) return '近 4 周'
	if (range == RANGE_12W) return '近 12 周'
	if (range == RANGE_6M) return '近半年'
	return '全部'
}

// 计算某个范围的日期边界（周一为一周起点），返回 { cur0, cur1, prev0, prev1, hasPrev }
// cur0 = 范围起始（含），cur1 = 范围结束（含，即 today）；全部范围 hasPrev=false
export type RangeBounds = { cur0 : string, cur1 : string, prev0 : string, prev1 : string, hasPrev : boolean }

export function calcRange(today : string, range : string) : RangeBounds {
	if (range == RANGE_ALL) {
		return { cur0: '', cur1: today, prev0: '', prev1: '', hasPrev: false } as RangeBounds
	}
	const days = rangeDays(range)
	const cur0 = addDaysStr(today, -(days - 1))
	const prev1 = addDaysStr(cur0, -1)
	const prev0 = addDaysStr(prev1, -(days - 1))
	return { cur0: cur0, cur1: today, prev0: prev0, prev1: prev1, hasPrev: true } as RangeBounds
}

// ---------------------------------------------------------------- 1RM 与有效组
// 从 Occurrence 的 sets 中挑出对某动作有效的组。
// - 跳过 reps=0 或非法 weight 的组；自重允许负/0/正，非自重负 weight 排除
// - 仅统计正式组（kinds='work'；但 DayEntry.records 已不含热身，此处只需做合法性过滤）
export function filterValidSets(sets : SetRecord[], bodyweight : boolean) : SetRecord[] {
	const out : SetRecord[] = []
	for (let i = 0; i < sets.length; i++) {
		const s = sets[i]
		if (!isValidStatGroup(s.weight, s.reps, bodyweight)) continue
		out.push(s)
	}
	return out
}

// 单组 Epley 1RM 结果：值或 null（无法计算时）
export function setOneRepMax(s : SetRecord, bodyweight : boolean) : number | null {
	return epleyOneRepMax(s.weight, s.reps, bodyweight)
}

// 找一次 Occurrence 里的"最佳组"：优先 1RM 最高；1RM 都 null 时（自重或 reps>12）
// 取 weight 最大（自重按带符号）；weight 相同再比 reps。
export type BestSet = { weight : number, reps : number, oneRepMax : number | null, index : number }
export function pickBestSet(sets : SetRecord[], bodyweight : boolean) : BestSet | null {
	const valid = filterValidSets(sets, bodyweight)
	if (valid.length == 0) return null
	let best : BestSet | null = null
	for (let i = 0; i < valid.length; i++) {
		const s = valid[i]
		const orm = setOneRepMax(s, bodyweight)
		const cur = { weight: s.weight, reps: s.reps, oneRepMax: orm, index: i } as BestSet
		if (best == null) { best = cur; continue }
		if (orm != null && best.oneRepMax != null) {
			// 两个都有 1RM：只比 1RM，不比 weight/reps
			if (orm > best.oneRepMax) best = cur
			continue
		}
		if (orm != null && best.oneRepMax == null) { best = cur; continue }  // 我有 1RM 而 best 没有
		if (orm == null && best.oneRepMax != null) continue                    // 我没有 1RM 而 best 有 → best 胜
		// 两个都没有 1RM（自重或 reps>12）：按带符号 max weight，weight 相同按 reps
		if (cur.weight > best.weight) { best = cur; continue }
		if (cur.weight == best.weight && cur.reps > best.reps) { best = cur; continue }
	}
	return best
}

// 一次 Occurrence 的完整统计
export type OccurrenceStats = {
	date : string
	at : number
	exerciseId : string
	name : string
	category : string
	isBodyweight : boolean
	// 有效组数
	totalSets : number
	// 最佳组（优先 1RM 最高）
	bestSet : BestSet | null
	// 最大 weight（自重按带符号；所有有效组）
	maxWeight : number
	// 最大 reps（所有有效组，weight 任意）
	maxReps : number
	// 估算 1RM 最大值（自重动作永远 null）
	maxOneRepMax : number | null
	// 容量：正的 weight × reps 之和；自重的负 weight 按 0 计
	volume : number
	// 数据来源：cloud | local
	source : string
}

export function buildOccurrenceStats(o : Occurrence, library : Exercise[]) : OccurrenceStats {
	const bw = isBodyweight(o.exerciseId, library)
	const valid = filterValidSets(o.sets, bw)
	let maxW = -Infinity
	let maxR = 0
	let maxOrm : number | null = null
	let vol = 0
	for (let i = 0; i < valid.length; i++) {
		const s = valid[i]
		if (s.weight > maxW) maxW = s.weight
		if (s.reps > maxR) maxR = s.reps
		const orm = setOneRepMax(s, bw)
		if (orm != null && (maxOrm == null || orm > maxOrm)) maxOrm = orm
		const add = s.weight > 0 ? s.weight * s.reps : 0  // 负 weight 不计入容量
		vol += add
	}
	const best = pickBestSet(o.sets, bw)
	const source = o.source == SOURCE_CLOUD ? SOURCE_CLOUD : SOURCE_LOCAL
	return {
		date: o.date, at: o.at,
		exerciseId: aliasExerciseId(o.exerciseId),
		name: o.name, category: o.category,
		isBodyweight: bw,
		totalSets: valid.length,
		bestSet: best,
		maxWeight: valid.length > 0 ? maxW : 0,
		maxReps: maxR,
		maxOneRepMax: maxOrm,
		volume: round1(vol),
		source: source
	} as OccurrenceStats
}

// ---------------------------------------------------------------- 训练序列（某动作在时间范围内的每次统计）
export type TrainingSequence = {
	exerciseId : string
	name : string
	category : string
	isBodyweight : boolean
	type : string  // '复合' | '孤立'（库里缺 type 时由 resolveExerciseTypeWithFallback 兜底）
	sets : OccurrenceStats[]  // 按时间升序
	count : number
}

// 兜底规则：库里 type 缺失（''）时，按该动作所有历史组的 reps 中位数判断
// 中位数 > 12 → '孤立'；否则 → '复合'；无历史数据 → '复合'（默认安全）
//
// 调用约束：items 必须是 collectOccurrences 输出的**全量历史**（不过滤 range）。
//   - 本函数内部会自己做 aliasExerciseId 映射，调用方不用预先处理
//   - 只统计 reps > 0 的组（reps<=0 排除；不做 filterValidSets——legacy 热身 reps 无法排除）
//   - 传入 range 过滤后的 items 会导致切换统计范围时 type 发生变化（不允许）
//
// 将来 type 影响：训练历史列表的复合/孤立 tag、概览按类型分组对比、
//   复合动作 1RM PR 高亮、新建训练推荐按 type 筛选
export function resolveExerciseTypeWithFallback(exerciseId : string, library : Exercise[], items : Occurrence[]) : string {
	const fromLib = exerciseType(exerciseId, library)
	if (fromLib == '复合' || fromLib == '孤立') return fromLib
	// 库里没 type 字段，走历史 reps 中位数
	const resolved = aliasExerciseId(exerciseId)
	const allReps : number[] = []
	for (let i = 0; i < items.length; i++) {
		const o = items[i]
		if (aliasExerciseId(o.exerciseId) != resolved) continue
		const sets = o.sets != null ? o.sets : []
		for (let j = 0; j < sets.length; j++) {
			const r = sets[j].reps
			if (r != null && r > 0) allReps.push(r)
		}
	}
	if (allReps.length == 0) return '复合'  // 无历史，默认复合
	allReps.sort((a : number, b : number) => a - b)
	const mid = Math.floor(allReps.length / 2)
	const median = allReps.length % 2 == 1 ? allReps[mid] : (allReps[mid - 1] + allReps[mid]) / 2
	return median > 12 ? '孤立' : '复合'
}

// items 需是 collectOccurrences 返回的已按时间升序数组；range='all' 表示不过滤
export function buildSequence(items : Occurrence[], exerciseId : string, library : Exercise[], range : string, today : string) : TrainingSequence {
	const resolved = aliasExerciseId(exerciseId)
	const bw = isBodyweight(exerciseId, library)
	const tp = resolveExerciseTypeWithFallback(exerciseId, library, items)
	const b = calcRange(today, range)
	const out : OccurrenceStats[] = []
	for (let i = 0; i < items.length; i++) {
		const o = items[i]
		if (aliasExerciseId(o.exerciseId) != resolved) continue
		if (range != RANGE_ALL) {
			if (o.date < b.cur0 || o.date > b.cur1) continue
		} else {
			if (o.date > today) continue
		}
		out.push(buildOccurrenceStats(o, library))
	}
	return {
		exerciseId: resolved,
		name: out.length > 0 ? out[0].name : '',
		category: exerciseCategory(exerciseId, library),
		isBodyweight: bw,
		type: tp,
		sets: out,
		count: out.length
	} as TrainingSequence
}

// ---------------------------------------------------------------- PR 识别
// 每个 occurrence 里：如果本次的 maxOneRepMax / maxWeight /（自重且 weight=0 时的 maxReps）
// 严格大于之前所有历史最好（不是只范围内），就算一条 PR。
// 每个动作第一次出现只作为基准，不算 PR。
export type PRItem = {
	exerciseId : string
	name : string
	date : string
	source : string
	prType : string  // 'oneRepMax' | 'maxWeight' | 'maxReps'
	value : number
}

export function findPRs(items : Occurrence[], library : Exercise[]) : PRItem[] {
	const out : PRItem[] = []
	// 每个动作的历史最好追踪
	const bestOrm = new Map<string, number>()
	const bestWt = new Map<string, number>()
	const bestReps = new Map<string, number>()
	for (let i = 0; i < items.length; i++) {
		const o = items[i]
		const id = aliasExerciseId(o.exerciseId)
		const bw = isBodyweight(o.exerciseId, library)
		const stats = buildOccurrenceStats(o, library)
		const firstTime = !bestOrm.has(id) && !bestWt.has(id)

		// oneRepMax PR（自重不算）
		if (!bw && stats.maxOneRepMax != null) {
			const prev = bestOrm.get(id)
			if (prev == null) bestOrm.set(id, stats.maxOneRepMax!)
			else if (stats.maxOneRepMax! > prev) {
				bestOrm.set(id, stats.maxOneRepMax!)
				out.push({ exerciseId: id, name: o.name, date: o.date, source: o.source, prType: 'oneRepMax', value: stats.maxOneRepMax! } as PRItem)
			}
		}
		// maxWeight PR（自重按带符号严格比较）
		if (stats.maxWeight > 0 || bw) {  // weight=0 只有自重才参与
			const prev = bestWt.get(id)
			if (prev == null) bestWt.set(id, stats.maxWeight)
			else if (stats.maxWeight > prev) {
				bestWt.set(id, stats.maxWeight)
				out.push({ exerciseId: id, name: o.name, date: o.date, source: o.source, prType: 'maxWeight', value: stats.maxWeight } as PRItem)
			}
		}
		// maxReps PR（自重 + weight=0 的组才参与，bodyweight=true）
		if (bw && stats.maxWeight == 0 && stats.maxReps > 0) {
			const prev = bestReps.get(id)
			if (prev == null) bestReps.set(id, stats.maxReps)
			else if (stats.maxReps > prev) {
				bestReps.set(id, stats.maxReps)
				out.push({ exerciseId: id, name: o.name, date: o.date, source: o.source, prType: 'maxReps', value: stats.maxReps } as PRItem)
			}
		}
		// 第一次出现但 stats 全 null/0 的，不更新 map 也不算 PR，等下一次
		if (firstTime && stats.maxOneRepMax == null && stats.maxWeight == 0 && stats.maxReps == 0) {
			// 什么都不做：让这个"第一次"保持基准但不被任何指标捕捉
		}
	}
	return out
}

// ---------------------------------------------------------------- 概览对比
export type PeriodOverview = {
	days : number      // 训练次数（按有训练的天数算，不是 DayEntry 数）
	sessions : number  // DayEntry counted 数（本机按场，legacy 按天；混合粒度）
	volume : number    // 总容量（kg；自重负 weight 按 0 计）
	newPRs : number    // 范围内新增 PR 数
}

export type OverviewCompare = {
	cur : PeriodOverview
	prev : PeriodOverview | null  // 上一周期；无则 null
	hasPrev : boolean
	daysDelta : number
	volumeDeltaPct : number
	prDelta : number
}

export function buildOverviewCompare(entries : DayEntry[], items : Occurrence[], prs : PRItem[], library : Exercise[], today : string, range : string) : OverviewCompare {
	const b = calcRange(today, range)

	function aggregate(from : string, to : string) : PeriodOverview {
		let sessions = 0
		const dates = new Set<string>()
		let volume = 0
		for (let i = 0; i < entries.length; i++) {
			const e = entries[i]
			if (!e.counted) continue
			if (e.date < from || e.date > to) continue
			sessions++
			dates.add(e.date)
			// DayEntry.volume 已排除热身，但自重负 weight 仍可能算在内（entryFromSession 只看 weightRequired，不看 weight 正负）
			// 这里粗略扣一下：自重动作 volume 只加正的 weight
			let entryVol = e.volume
			for (let j = 0; j < e.exercises.length; j++) {
				const ex = e.exercises[j]
				const bw = isBodyweight(ex.exerciseId, library)
				if (bw && ex.records.length > 0) {
					for (let k = 0; k < ex.records.length; k++) {
						const s = ex.records[k]
						if (s.weight < 0) entryVol -= s.weight * s.reps  // 负的加回去变 0
					}
				}
			}
			volume += round1(entryVol)
		}
		let newPRs = 0
		for (let i = 0; i < prs.length; i++) {
			if (prs[i].date >= from && prs[i].date <= to) newPRs++
		}
		return { days: dates.size, sessions: sessions, volume: round1(volume), newPRs: newPRs } as PeriodOverview
	}

	const cur = b.hasPrev ? aggregate(b.cur0, b.cur1) : aggregate('0000-00-00', b.cur1)
	let prev : PeriodOverview | null = null
	if (b.hasPrev) prev = aggregate(b.prev0, b.prev1)

	const hasPrev = b.hasPrev && prev != null && (prev.sessions > 0 || prev.volume > 0)
	const daysDelta = hasPrev ? cur.days - prev!.days : 0
	const volumeDeltaPct = hasPrev && prev!.volume > 0 ? round1((cur.volume - prev!.volume) / prev!.volume * 100) : 0
	const prDelta = hasPrev ? cur.newPRs - prev!.newPRs : 0

	return {
		cur: cur,
		prev: prev,
		hasPrev: hasPrev,
		daysDelta: daysDelta,
		volumeDeltaPct: volumeDeltaPct,
		prDelta: prDelta
	} as OverviewCompare
}

// ========================================================================
// 数据统计页专用新函数
// ========================================================================

// 最长连续达标周：周达标 = 该周训练天数 >= goalForWeek 的 goal
// 只统计 range 内的周；weekStart 从本周往前推
export function longestStreakWeeks(entries : DayEntry[], today : string, cfg : WeeklyGoalConfig, range : string) : number {
	const b = calcRange(today, range)
	const trainedDates = new Set<string>()
	for (let i = 0; i < entries.length; i++) {
		const e = entries[i]
		if (!e.counted || e.date > today) continue
		if (range != RANGE_ALL && e.date < b.cur0) continue
		trainedDates.add(e.date)
	}
	// 从本周往前推周
	const thisWeek = weekStartOf(today)
	let week = thisWeek
	let startWeek : string
	if (range == RANGE_ALL) {
		startWeek = ''
	} else {
		startWeek = weekStartOf(b.cur0)
	}
	// 先从 startWeek 之后开始（含 startWeek）
	const metWeeks : boolean[] = []
	// 收集所有周（从 startWeek 到 thisWeek）
	const allWeeks : string[] = []
	let cursor = thisWeek
	while (true) {
		allWeeks.unshift(cursor)
		if (cursor == startWeek) break
		if (cursor < startWeek) break
		cursor = addDaysStr(cursor, -7)
	}
	if (startWeek == '') {
		// range=all，往前推到有记录为止（最多 3 年）
		cursor = addDaysStr(thisWeek, -7)
		for (let w = 0; w < 156; w++) {
			allWeeks.unshift(cursor)
			cursor = addDaysStr(cursor, -7)
			// 如果这一周及其后都没训练就停了（但为了准确性，还是全部算）
		}
	}
	for (let wi = 0; wi < allWeeks.length; wi++) {
		const ws = allWeeks[wi]
		const we = addDaysStr(ws, 6)
		let days = 0
		for (let d = 0; d < 7; d++) {
			const date = addDaysStr(ws, d)
			if (date > today) break
			if (trainedDates.has(date)) days++
		}
		const goal = goalForWeek(cfg, ws).goal
		metWeeks.push(days >= goal)
	}
	// 从后往前找（最近连续达标）
	let streak = 0
	for (let i = metWeeks.length - 1; i >= 0; i--) {
		if (metWeeks[i]) streak++
		else break
	}
	return streak
}

// 范围内周达标情况：metWeeks / totalWeeks
// 口径：
//   - 分母 = 所选区间内的自然周数（周一为一周起点）
//   - 如果第一次训练晚于区间起点，则从第一次训练所在的周开始算
//   - 当前这周还没结束：已经达标则计入分子和分母；没达标则分子分母都不计
//   - 每周是否达标：该周训练天数 >= goalForWeek(cfg, 周起点).goal
export type WeeksGoalProgress = { metWeeks : number, totalWeeks : number }
export function weeksGoalProgress(entries : DayEntry[], today : string, cfg : WeeklyGoalConfig, range : string) : WeeksGoalProgress {
	const b = calcRange(today, range)
	const trainedDates = new Set<string>()
	let firstTrained = ''
	for (let i = 0; i < entries.length; i++) {
		const e = entries[i]
		if (!e.counted || e.date > today) continue
		trainedDates.add(e.date)
		if (firstTrained == '' || e.date < firstTrained) firstTrained = e.date
	}
	const thisWeek = weekStartOf(today)
	// 起点周 = max(区间起点所在周, 首次训练所在周)；range=all 时直接取首次训练所在周
	let startWeek = ''
	if (range == RANGE_ALL) {
		startWeek = firstTrained == '' ? '' : weekStartOf(firstTrained)
	} else {
		const rangeWeek = weekStartOf(b.cur0)
		if (firstTrained == '') {
			startWeek = rangeWeek
		} else {
			const firstWeek = weekStartOf(firstTrained)
			startWeek = firstWeek > rangeWeek ? firstWeek : rangeWeek
		}
	}
	if (startWeek == '' || startWeek > thisWeek) return { metWeeks: 0, totalWeeks: 0 }
	let metWeeks = 0
	let totalWeeks = 0
	let ws = startWeek
	while (ws <= thisWeek) {
		let days = 0
		for (let d = 0; d < 7; d++) {
			const date = addDaysStr(ws, d)
			if (date > today) break
			if (trainedDates.has(date)) days++
		}
		const goal = goalForWeek(cfg, ws).goal
		if (addDaysStr(ws, 6) <= today) {
			// 已结束的周：进分母，达标进分子
			totalWeeks++
			if (days >= goal) metWeeks++
		} else {
			// 当前周还没结束：已达标才计入，未达标不进分母
			if (days >= goal) {
				totalWeeks++
				metWeeks++
			}
		}
		ws = addDaysStr(ws, 7)
	}
	return { metWeeks: metWeeks, totalWeeks: totalWeeks }
}

// 概览卡专用：训练次数 / 总容量 / 周达标
export type TrainDaysOverview = { cur : number, prev : number, delta : number, showDelta : boolean }
export type VolumeOverview = { cur : number, prev : number, deltaPct : number, showDelta : boolean }
export type AnalyticsOverview = {
	trainDays : TrainDaysOverview
	volume : VolumeOverview
	weeksGoal : WeeksGoalProgress
}

export function buildOverviewForAnalytics(entries : DayEntry[], library : Exercise[], prs : PRItem[], today : string, range : string, cfg : WeeklyGoalConfig) : AnalyticsOverview {
	const oc = buildOverviewCompare(entries, [], prs, library, today, range)
	const wp = weeksGoalProgress(entries, today, cfg, range)
	return {
		trainDays: { cur: oc.cur.days, prev: oc.hasPrev ? oc.prev!.days : 0, delta: oc.hasPrev ? oc.daysDelta : 0, showDelta: oc.hasPrev } as TrainDaysOverview,
		volume: { cur: oc.cur.volume, prev: oc.hasPrev ? oc.prev!.volume : 0, deltaPct: oc.hasPrev ? oc.volumeDeltaPct : 0, showDelta: oc.hasPrev } as VolumeOverview,
		weeksGoal: { metWeeks: wp.metWeeks, totalWeeks: wp.totalWeeks } as WeeksGoalProgress
	} as AnalyticsOverview
}

// 根据 library 判断某动作的默认 metric（库里有 type='孤立' 或 bodyweight=true 决定）
export function defaultMetricForOption(opt : ExerciseOption, library : Exercise[]) : string {
	const resolved = aliasExerciseId(opt.id)
	const bw = isBodyweight(resolved, library)
	if (bw) return METRIC_MAX_REPS
	const tp = exerciseType(resolved, library)
	if (tp == '孤立') return METRIC_WEIGHT
	return METRIC_E1RM
}
