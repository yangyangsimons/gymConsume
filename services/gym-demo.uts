import { Exercise, parseDate, weekdayIndex } from './gym-stats.uts'
import { KIND_WARMUP, KIND_WORK, RIR_UNSET, SessionExercise, SetEntry, WorkoutSession, defaultTarget, isWeightRequired } from './workout-session.uts'
import { addDaysStr } from './gym-calendar.uts'

// ================== 演示数据开关 ==================
// 仅用于在没有真实历史时预览数据页效果：改为 true 后，数据页只使用下面本地生成的示例数据。
// - 不读取也不写入云端，不读取本机真实训练记录，不会混入真实历史；
// - 数据页会显示“演示数据”标识；
// - 保持 false（默认）时，没有数据一律显示空状态，不会回退到演示数据。
export const DEMO_MODE = false

// 演示动作库：覆盖有记录 / 单数据点 / 无记录 / 不支持重量指标（自重）/ 动作变式（杠铃卧推 ≠ 哑铃卧推）
export function demoExercises() : Exercise[] {
	const rows : string[][] = [
		['chest-01', '杠铃卧推', '胸大肌 · 三头肌', '卧', '胸', 'gangling woutui'],
		['chest-02', '上斜哑铃卧推', '上胸 · 三角肌前束', '斜', '胸', 'shangxie yaling woutui'],
		['chest-03', '绳索夹胸', '胸大肌', '夹', '胸', 'shengsuo jiaxiong'],
		['chest-05', '哑铃卧推', '胸大肌 · 三头肌', '卧', '胸', 'yaling woutui'],
		['back-01', '引体向上', '背阔肌 · 二头肌', '引', '背', 'yintixiangshang'],
		['legs-01', '杠铃深蹲', '股四头肌 · 臀大肌', '蹲', '腿', 'gangling shendun'],
		['shoulder-01', '杠铃推举', '三角肌前束 · 三头肌', '推', '肩', 'gangling tuiju'],
		['arm-01', '杠铃弯举', '肱二头肌', '弯', '手臂', 'gangling wanju'],
		['core-01', '平板支撑', '腹横肌 · 核心', '板', '核心', 'pingban zhicheng']
	]
	return rows.map((r : string[]) : Exercise => ({ _id: r[0], name: r[1], sub: r[2], icon: r[3], category: r[4], pinyin: r[5] } as Exercise))
}

let seq = 0

function entry(kind : string, weight : number, reps : number, done : boolean) : SetEntry {
	seq++
	return { id: 'demo_set_' + seq, kind: kind, weight: weight > 0 ? '' + weight : '', reps: reps > 0 ? '' + reps : '', rir: RIR_UNSET, done: done } as SetEntry
}

function exercise(id : string, name : string, category : string, sets : SetEntry[]) : SessionExercise {
	seq++
	return {
		id: 'demo_ex_' + seq,
		exerciseId: id,
		name: name,
		category: category,
		weightRequired: isWeightRequired(id, category),
		target: defaultTarget(),
		sets: sets,
		cloudSynced: false
	} as SessionExercise
}

function session(date : string, hour : number, exercises : SessionExercise[]) : WorkoutSession {
	seq++
	const d = parseDate(date)
	const start = new Date(d.getFullYear(), d.getMonth(), d.getDate(), hour, 0).getTime()
	return {
		version: 1,
		id: 'demo_ws_' + seq,
		date: date,
		startedAt: start,
		updatedAt: start,
		finishedAt: start + 55 * 60000,
		status: 'finished',
		exercises: exercises,
		editing: null,
		// 非 synced：这些是本机演示会话，会被统一统计函数当作已结束训练处理，但不会被提交到任何地方
		cloudStatus: 'pending',
		durationSent: false
	} as WorkoutSession
}

function round25(x : number) : number {
	return Math.round(x / 2.5) * 2.5
}

function benchSets(w : number, withUndone : boolean) : SetEntry[] {
	const sets : SetEntry[] = [
		entry(KIND_WARMUP, round25(w * 0.6), 10, true),
		entry(KIND_WORK, w, 10, true),
		entry(KIND_WORK, w + 2.5, 8, true),
		entry(KIND_WORK, w + 2.5, 6, true),
		entry(KIND_WORK, w, 10, true)
	]
	// 已填写但没有完成的组：不计入任何统计
	if (withUndone) sets.push(entry(KIND_WORK, w + 5, 5, false))
	return sets
}

// 以 today 为基准的确定性演示数据（不使用随机数，每次打开结果一致）
export function demoSessions(today : string) : WorkoutSession[] {
	seq = 0
	const out : WorkoutSession[] = []
	let wed = 0
	for (let d = 1; d <= 300; d++) {
		const date = addDaysStr(today, -d)
		const wd = weekdayIndex(parseDate(date))
		const h = (d * 37 + 11) % 10
		const base = 40 + (300 - d) * 0.1
		if (wd == 0 && h < 8) {
			const list : SessionExercise[] = [exercise('chest-01', '杠铃卧推', '胸', benchSets(round25(base), d % 5 == 0))]
			if (d % 3 == 0) list.push(exercise('chest-02', '上斜哑铃卧推', '胸', [entry(KIND_WORK, 20, 10, true), entry(KIND_WORK, 20, 9, true), entry(KIND_WORK, 22.5, 8, true)]))
			out.push(session(date, 18, list))
			// 同一天第二场训练
			if (d % 28 < 7) {
				out.push(session(date, 21, [exercise('chest-01', '杠铃卧推', '胸', [entry(KIND_WORK, round25(base * 0.8), 12, true), entry(KIND_WORK, round25(base * 0.8), 12, true)])]))
			}
		} else if (wd == 2 && h < 7) {
			wed++
			// 少数高组数的训练日，用于展示热力图的深色档位
			const many = wed % 9 == 0 ? 12 : (wed % 5 == 0 ? 8 : 3)
			const squat : SetEntry[] = []
			for (let k = 0; k < many; k++) squat.push(entry(KIND_WORK, round25(base * 1.3), k < 3 ? 8 : 6, true))
			const pulls : SetEntry[] = [entry(KIND_WORK, 0, 8, true), entry(KIND_WORK, 0, 7, true), entry(KIND_WORK, 0, 6, true)]
			if (many > 3) pulls.push(entry(KIND_WORK, 0, 6, true), entry(KIND_WORK, 0, 5, true))
			out.push(session(date, 19, [exercise('legs-01', '杠铃深蹲', '腿', squat), exercise('back-01', '引体向上', '背', pulls)]))
		} else if (wd == 4 && h < 7) {
			out.push(session(date, 18, [exercise('chest-01', '杠铃卧推', '胸', benchSets(round25(base - 5), false))]))
		} else if (wd == 5 && h < 4) {
			out.push(session(date, 10, [exercise('chest-05', '哑铃卧推', '胸', [entry(KIND_WORK, 24, 10, true), entry(KIND_WORK, 24, 9, true)])]))
		}
	}
	// 单数据点动作
	out.push(session(addDaysStr(today, -12), 17, [exercise('shoulder-01', '杠铃推举', '肩', [entry(KIND_WORK, 40, 8, true), entry(KIND_WORK, 40, 7, true)])]))
	// 缺少动作 ID 的旧记录：计入热力图，但不归属到任何动作
	out.push(session(addDaysStr(today, -20), 9, [exercise('', '旧版卧推记录', '胸', [entry(KIND_WORK, 50, 8, true)])]))
	// 一场没有任何已完成组的训练，不应产生任何统计
	out.push(session(addDaysStr(today, -2), 8, [exercise('chest-01', '杠铃卧推', '胸', [entry(KIND_WORK, 60, 8, false)])]))
	return out
}
