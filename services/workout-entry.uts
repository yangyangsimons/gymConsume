import { WorkoutSession, sessionHasContent } from './workout-session.uts'

// 首页“开始 / 继续训练”的决策（纯逻辑）。
// 只有存在“确实有内容”的未结束训练时才需要用户确认继续原记录还是另开一场；
// 空草稿不触发恢复或冲突提示，已结束但同步失败的记录也不阻止开始新训练。
export const PLAN_CONTINUE = 'continue'
export const PLAN_NEW = 'new'

export type StartPlan = {
	// continue：存在有内容的未结束训练，点击后确认继续原记录 / 另开一场 | new：直接新建
	kind : string
	// continue 时指向该训练的 ID，new 时为空串
	sessionId : string
	// 对应训练的开始日期
	date : string
}

function plan(kind : string, id : string, date : string) : StartPlan {
	return { kind: kind, sessionId: id, date: date } as StartPlan
}

// current：当前会话；history：本机历史中其他未结束草稿由 history 提供
export function planStart(current : WorkoutSession | null, history : WorkoutSession[]) : StartPlan {
	const actives : WorkoutSession[] = []
	if (current != null && current.status == 'active' && sessionHasContent(current)) actives.push(current)
	for (let i = 0; i < history.length; i++) {
		const s = history[i]
		if (s.status != 'active' || !sessionHasContent(s)) continue
		if (!actives.some((a : WorkoutSession) : boolean => a.id == s.id)) actives.push(s)
	}
	if (actives.length == 0) return plan(PLAN_NEW, '', '')
	// 多场未结束时以最近开始的一场作为“原记录”
	let pick = actives[0]
	for (let i = 1; i < actives.length; i++) {
		if (actives[i].startedAt > pick.startedAt) pick = actives[i]
	}
	return plan(PLAN_CONTINUE, pick.id, pick.date)
}
