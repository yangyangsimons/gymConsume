import { WorkoutSession } from './workout-session.uts'
import { cloudStatus, retryCloud } from './gym-cloud.uts'

// Reuses the durable outbox written by saveSession; never appends per-exercise logs.
export async function syncSessionToCloud(session : WorkoutSession) : Promise<string> {
	await retryCloud('session', session.id)
	return cloudStatus('session', session.id)
}
