import { Exercise, Workout } from './gym-stats.uts'
import { cloudOwner, cloudRows } from './gym-cloud.uts'

type ReadReply = {
	ok : boolean
	code ?: string
	rows : UTSJSONObject[]
}

async function readPage(action : string, skip : number) : Promise<UTSJSONObject[]> {
	const result = await wx.cloud.callFunction({ name: 'gymData', data: { action: action, skip: skip } })
	const reply = result.result as ReadReply
	if (reply == null || !reply.ok) throw new Error(reply?.code ?? 'INVALID_CLOUD_RESPONSE')
	return reply.rows
}

async function fetchAll(action : string) : Promise<UTSJSONObject[]> {
	const rows : UTSJSONObject[] = []
	while (true) {
		const page = await readPage(action, rows.length)
		for (let i = 0; i < page.length; i++) rows.push(page[i])
		if (page.length < 20) return rows
	}
}

// 动作库按账号缓存：先用缓存秒开，再后台刷新；同一时间只发一组云端请求
const LIBRARY_PREFIX = 'gymConsume.exerciseLibrary.v1.'
let libraryOwner = ''
let libraryMemory : Exercise[] | null = null
let libraryLoading : Promise<Exercise[]> | null = null

function libraryKey() : string {
	const o = cloudOwner()
	return LIBRARY_PREFIX + (o == '' ? 'unbound' : o)
}

function withCustom(base : Exercise[]) : Exercise[] {
	const out : Exercise[] = base.slice()
	const custom = cloudRows('exercise')
	for (let i = 0; i < custom.length; i++) {
		const ex = custom[i].value as Exercise
		if (ex != null && !out.some((e : Exercise) : boolean => e._id == ex._id)) out.push(ex)
	}
	return out
}

export function cachedExercises() : Exercise[] | null {
	const key = libraryKey()
	if (libraryMemory == null || libraryOwner != key) {
		libraryMemory = null
		libraryOwner = key
		try {
			const raw = uni.getStorageSync(key)
			if (typeof raw == 'string' && raw != '') libraryMemory = JSON.parse(raw) as Exercise[]
		} catch (e) {
			console.error('Exercise library cache could not be read', e)
		}
	}
	return libraryMemory == null ? null : withCustom(libraryMemory!)
}

export function loadExercises() : Promise<Exercise[]> {
	if (libraryLoading != null) return libraryLoading!
	const key = libraryKey()
	const task = fetchAll('library').then((rows : UTSJSONObject[]) : Exercise[] => {
		const base : Exercise[] = []
		for (let i = 0; i < rows.length; i++) base.push(rows[i] as Exercise)
		libraryOwner = key
		libraryMemory = base
		try {
			uni.setStorageSync(key, JSON.stringify(base))
		} catch (e) {
			console.error('Exercise library cache could not be saved', e)
		}
		return withCustom(base)
	})
	libraryLoading = task
	task.then(() => { libraryLoading = null }, () => { libraryLoading = null })
	return task
}

// Legacy cloud records are read only and scoped by trusted OPENID in gymData.
// New records/drafts retain the full WorkoutSession schema in gym_private.
export async function loadWorkouts() : Promise<Workout[]> {
	const rows = await fetchAll('legacy')
	return rows.map((row : UTSJSONObject) : Workout => row as Workout)
}
