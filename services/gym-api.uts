import { Exercise, Workout } from './gym-stats.uts'
import { cloudRows } from './gym-cloud.uts'

type ReadReply = {
	ok : boolean
	code ?: string
	rows : UTSJSONObject[]
}

async function readPage(action : string, skip : number) : Promise<UTSJSONObject[]> {
	const result = await wx.cloud.callFunction({ name: 'gymData', data: { action: action, skip: skip } })
	const reply = result.result as ReadReply
	if (reply == null || !reply.ok) throw new Error(reply?.code ?? 'INVALID_CLOUD_RESPONSE')
	return reply.rows
}

async function fetchAll(action : string) : Promise<UTSJSONObject[]> {
	const rows : UTSJSONObject[] = []
	while (true) {
		const page = await readPage(action, rows.length)
		for (let i = 0; i < page.length; i++) rows.push(page[i])
		if (page.length < 20) return rows
	}
}

export async function loadExercises() : Promise<Exercise[]> {
	const rows = await fetchAll('library')
	const out : Exercise[] = []
	for (let i = 0; i < rows.length; i++) out.push(rows[i] as Exercise)
	const custom = cloudRows('exercise')
	for (let i = 0; i < custom.length; i++) {
		const ex = custom[i].value as Exercise
		if (ex != null && !out.some((e : Exercise) : boolean => e._id == ex._id)) out.push(ex)
	}
	return out
}

// Legacy cloud records are read only and scoped by trusted OPENID in gymData.
// New records/drafts retain the full WorkoutSession schema in gym_private.
export async function loadWorkouts() : Promise<Workout[]> {
	const rows = await fetchAll('legacy')
	return rows.map((row : UTSJSONObject) : Workout => row as Workout)
}
