		font-weight: 700;
		white-space: nowrap;
	}

	.we-card-count-unit {
		color: #7d8982;
		font-size: 11px;
		font-weight: 400;
	}

	.we-bar {
		height: 6px;
		margin: 12px 0 10px;
		border-radius: 3px;
		background-color: #eaf0ec;
	}

	.we-bar-fill {
		height: 6px;
		border-radius: 3px;
		background-color: #28b77a;
	}

	.we-card-bottom {
		display: flex;
		flex-direction: row;
		align-items: center;
