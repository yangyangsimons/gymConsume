<template>
	<view class="we-page">
		<scroll-view :show-scrollbar="false" class="we-scroll" scroll-y="true">
			<view class="we-content" v-if="slot != null">
				<view class="we-head">
					<view class="we-head-top">
						<view class="we-head-copy">
							<text class="we-kicker">{{ isMakeup ? 'MAKE-UP RECORD' : 'EDIT RECORD' }}</text>
							<text class="we-date">{{ dateLabel }}</text>
						</view>
						<text class="we-tag">{{ isMakeup ? '补记' : '编辑' }}</text>
					</view>
					<text class="we-sub">{{ isMakeup ? '记录补到 ' + slot.session.date + '，保存后计入该日期的统计' : '修改原记录，ID 与训练日期保持不变' }}</text>
				</view>

				<view class="we-note">
					<text class="we-note-text">不启动计时，也不影响当前未结束的训练。填写内容会自动保存在草稿里，点击「保存记录」后才写入；未保存前退出，草稿会保留。</text>
				</view>

				<view class="we-list">
					<text class="we-empty" v-if="cards.length === 0">还没有添加动作</text>
					<view class="we-card" v-for="card in cards" :key="card.id">
						<view class="we-card-top">
							<view class="we-card-copy">
								<text class="we-card-name">{{ card.name }}</text>
								<text class="we-card-target">{{ card.targetLabel }}</text>
							</view>
							<text class="we-card-count">{{ card.workDone }}/{{ card.workTarget }}<text class="we-card-count-unit"> 正式组</text></text>
						</view>
						<view class="we-bar">
							<view class="we-bar-fill" :style="{ width: card.pct + '%' }"></view>
						</view>
						<view class="we-card-bottom">
							<text class="we-card-detail">{{ card.detail }}</text>
							<view class="we-card-actions">
								<button class="we-link" @click="onEdit(card.index)">编辑</button>
								<button class="we-link danger" @click="onRemove(card.index)">删除</button>
							</view>
						</view>
					</view>
				</view>

				<button class="we-add" @click="onAdd">
					<gym-icon name="plus-brand" :size="18"></gym-icon>
					<text>添加动作</text>
				</button>
				<button class="we-batch" v-if="cards.length > 0" @click="onMarkAll">把已填写的组全部标记为完成</button>
				<view class="we-pad"></view>
			</view>
		</scroll-view>

		<view class="we-footer" v-if="slot != null">
			<view class="we-footer-row">
				<button class="we-secondary" @click="onDiscard">放弃</button>
				<button class="we-primary" :disabled="busy" @click="onSave">{{ busy ? '保存中…' : '保存记录' }}</button>
			</view>
			<view class="we-safe"></view>
		</view>

		<gym-workout-sheet v-if="sheetOpen" :edit-index="editIndex" :edit-slot="true" @close="onSheetClose"
			@saved="onSheetSaved"></gym-workout-sheet>
	</view>
</template>

<script setup lang="uts">
	import { formatDate, parseDate } from '@/services/gym-stats.uts'
	import {
		EditSlot, SessionExercise, beginHistoryEdit, beginMakeupEdit, commitEdit, discardEdit, exerciseProgress, formatTarget,
		markFilledSetsDone, peekEdit, saveEditSlotSession
	} from '@/services/workout-session.uts'
	import { confirmDialog } from '@/services/gym-dialog.uts'
	import { flushCloud } from '@/services/gym-cloud.uts'

	type ExerciseCard = {
		index : number
		id : string
		name : string
		targetLabel : string
		workDone : number
		workTarget : number
		pct : number
		detail : string
	}

	const weekNames : string[] = ['日', '一', '二', '三', '四', '五', '六']

	const slot = ref<EditSlot | null>(null)
	const isMakeup = ref<boolean>(true)
	const sheetOpen = ref<boolean>(false)
	const editIndex = ref<number>(-1)
	const busy = ref<boolean>(false)

	function reload() {
		slot.value = peekEdit()
	}

	function slotLabel(s : EditSlot) : string {
		return s.mode == 'makeup' ? '补记 ' + s.session.date + ' 的草稿' : '一条编辑草稿'
	}

	function goBack() {
		uni.navigateBack({
			fail: () => {
				// 页面栈只有本页时（例如被重定向进来）返回首页，避免保存后卡住
				uni.reLaunch({ url: '/pages/home/home' })
			}
		})
	}

	onLoad((options : OnLoadOptions) => {
		const opts = options as any
		const mode = ((opts['mode'] ?? '') as string)
		const date = ((opts['date'] ?? '') as string)
		const id = ((opts['id'] ?? '') as string)

		console.log('[WE.onLoad] mode=' + mode + ' date=' + date + ' id=' + id)

		// ★ 先确认参数合法：避免 openFresh 里 beginMakeupEdit 因 isValidDate/未来日期 直接返回 null 导致闪一下
		if (mode == 'makeup') {
			const todayStr = formatDate(new Date())
			if (date == '') {
				console.log('[WE.onLoad] date 为空 → goBack')
				uni.showToast({ title: '日期缺失', icon: 'none' })
				setTimeout(() => goBack(), 400)
				return
			}
			if (date > todayStr) {
				console.log('[WE.onLoad] date=' + date + ' > today=' + todayStr + ' → goBack')
				uni.showToast({ title: '只能补记今天或过去的日期', icon: 'none' })
				setTimeout(() => goBack(), 600)
				return
			}
		}

		const existing = peekEdit()
		const matches = existing != null &&
			((mode == 'makeup' && existing.mode == 'makeup' && existing.session.date == date) ||
				(mode == 'edit' && existing.mode == 'edit' && existing.session.id == id))
		console.log('[WE.onLoad] peekEdit=' + (existing != null ? (existing.mode + '/' + existing.session.date) : 'null') + ' matches=' + matches)
		if (existing != null && !matches) {
			console.log('[WE.onLoad] existing 不匹配 → 弹 modal')
			uni.showModal({
				title: '有未保存的草稿',
				content: '已存在' + slotLabel(existing) + '。可以继续它，或放弃后开始新的。',
				confirmText: '继续草稿',
				cancelText: '开始新的',
				success: (res : ShowModalSuccess) => {
					if (res.confirm) {
						slot.value = existing
						isMakeup.value = existing.mode == 'makeup'
					} else {
						console.log('[WE.onLoad] 用户选放弃 → discardEdit + openFresh')
						discardEdit()
						openFresh(mode, date, id)
					}
				},
				fail: () => goBack()
			})
			return
		}
		console.log('[WE.onLoad] 直接 openFresh')
		openFresh(mode, date, id)
	})

	function openFresh(mode : string, date : string, id : string) {
		let opened : EditSlot | null = null
		if (mode == 'makeup') {
			opened = beginMakeupEdit(date)
			const peekAfter = peekEdit()
			console.log('[WE.openFresh] beginMakeupEdit=' + (opened != null ? 'ok' : 'null') + ' peekAfter=' + (peekAfter != null ? (peekAfter.mode + '/' + peekAfter.session.date) : 'null'))
			if (opened == null) {
				if (peekAfter == null) {
					console.log('[WE.openFresh] ★ opened==null && peek==null → 合法日期/未来日期检查失败 → goBack 闪一下！')
					uni.showToast({ title: '日期无效或已是未来', icon: 'none' })
					setTimeout(() => goBack(), 600)
					return
				}
				// opened==null 但 peekAfter!=null → existing 不匹配（onLoad 应该已经拦截）
				// 这里作为 double check：直接用 peekAfter 弹 modal 让用户选
				console.log('[WE.openFresh] ★ opened==null 但 peekAfter!=null → existing 不匹配 → 弹 modal 兜底')
				uni.showModal({
					title: '有未保存的草稿',
					content: '已存在' + slotLabel(peekAfter) + '。继续它，或放弃后开始新的？',
					confirmText: '继续草稿',
					cancelText: '开始新的',
					success: (res : ShowModalSuccess) => {
						if (res.confirm) {
							slot.value = peekAfter
							isMakeup.value = peekAfter.mode == 'makeup'
						} else {
							discardEdit()
							opened = beginMakeupEdit(date)
							if (opened == null) {
								console.log('[WE.openFresh] 二次 beginMakeupEdit 还是 null → goBack')
								goBack()
								return
							}
							isMakeup.value = opened.mode == 'makeup'
							slot.value = opened
						}
					},
					fail: () => goBack()
				})
				return
			}
		} else if (mode == 'edit') {
			opened = beginHistoryEdit(id)
			const peekAfter = peekEdit()
			console.log('[WE.openFresh] beginHistoryEdit=' + (opened != null ? 'ok' : 'null') + ' peekAfter=' + (peekAfter != null ? peekAfter.mode : 'null'))
			if (opened == null) {
				if (peekAfter == null) {
					uni.showToast({ title: '记录不存在或尚未结束，无法编辑', icon: 'none' })
					setTimeout(() => goBack(), 600)
					return
				}
				console.log('[WE.openFresh] opened==null 但 peekAfter!=null → 弹 modal 兜底')
				uni.showModal({
					title: '有未保存的草稿',
					content: '已存在' + slotLabel(peekAfter) + '。继续它，或放弃后开始新的？',
					confirmText: '继续草稿',
					cancelText: '开始新的',
					success: (res : ShowModalSuccess) => {
						if (res.confirm) {
							slot.value = peekAfter
							isMakeup.value = peekAfter.mode == 'makeup'
						} else {
							discardEdit()
							opened = beginHistoryEdit(id)
							if (opened == null) { goBack(); return }
							isMakeup.value = opened.mode == 'makeup'
							slot.value = opened
						}
					},
					fail: () => goBack()
				})
				return
			}
		}
		if (opened == null) {
			console.log('[WE.openFresh] 最后兜底 goBack')
			goBack()
			return
		}
		console.log('[WE.openFresh] ★ 成功 slot.value 已设置')
		isMakeup.value = opened.mode == 'makeup'
		slot.value = opened
	}

	const dateLabel = computed(() : string => {
		const s = slot.value
		if (s == null) return ''
		const d = parseDate(s.session.date)
		return (d.getMonth() + 1) + '月' + d.getDate() + '日 · 星期' + weekNames[d.getDay()]
	})

	const cards = computed(() : ExerciseCard[] => {
		const out : ExerciseCard[] = []
		const s = slot.value
		if (s == null) return out
		for (let i = 0; i < s.session.exercises.length; i++) {
			const ex = s.session.exercises[i]
			const p = exerciseProgress(ex)
			const parts : string[] = []
			if (p.warmupTotal > 0) parts.push('热身 ' + p.warmupDone + '/' + p.warmupTotal)
			if (p.unfinished > 0) parts.push(p.unfinished + ' 组未完成')
			out.push({
				index: i,
				id: ex.id,
				name: ex.name,
				targetLabel: formatTarget(ex.target),
				workDone: p.workDone,
				workTarget: p.workTarget,
				pct: p.workTarget > 0 ? Math.min(100, Math.round(p.workDone / p.workTarget * 100)) : 0,
				detail: parts.length > 0 ? parts.join(' · ') : '全部组已完成'
			} as ExerciseCard)
		}
		return out
	})

	function onAdd() {
		editIndex.value = -1
		sheetOpen.value = true
	}

	function onEdit(index : number) {
		editIndex.value = index
		sheetOpen.value = true
	}

	async function onRemove(index : number) {
		const s = slot.value
		if (s == null || index < 0 || index >= s.session.exercises.length) return
		const ex = s.session.exercises[index]
		const ok = await confirmDialog('删除动作', '将移除“' + ex.name + '”及其所有组记录，保存后生效。', '删除', '取消')
		if (!ok) return
		s.session.exercises.splice(index, 1)
		if (!saveEditSlotSession(s.session)) uni.showToast({ title: '本机保存失败，请重试', icon: 'none' })
		reload()
	}

	function onMarkAll() {
		const s = slot.value
		if (s == null) return
		const n = markFilledSetsDone(s.session)
		if (n == 0) {
			uni.showToast({ title: '没有可标记的组：需先填写重量和次数', icon: 'none' })
			return
		}
		saveEditSlotSession(s.session)
		reload()
		uni.showToast({ title: '已标记 ' + n + ' 组为完成', icon: 'none' })
	}

	function onSheetClose() {
		sheetOpen.value = false
		reload()
	}

	function onSheetSaved() {
		sheetOpen.value = false
		reload()
	}

	async function onSave() {
		const s = slot.value
		if (s == null || busy.value) return
		busy.value = true
		const result = commitEdit(s)
		if (result == 'empty') {
			busy.value = false
			uni.showToast({ title: '没有已完成的组，保存后不会生成记录', icon: 'none' })
			return
		}
		if (result == 'stale') {
			busy.value = false
			uni.showToast({ title: '原记录已变化或保存失败，请重试', icon: 'none' })
			return
		}
		uni.showToast({ title: '已保存到本机', icon: 'none' })
		flushCloud().catch((e : unknown) => console.error('Record saved locally; automatic cloud retry pending', e))
		goBack()
	}

	async function onDiscard() {
		const s = slot.value
		if (s == null) return
		const content = s.mode == 'makeup' ? '已填写的内容将被丢弃，不会生成记录。' : '修改内容将被丢弃，原记录保持不变。'
		const ok = await confirmDialog('放弃草稿？', content, '放弃', '继续编辑')
		if (!ok) return
		discardEdit()
		goBack()
	}
</script>

<style lang="scss">
