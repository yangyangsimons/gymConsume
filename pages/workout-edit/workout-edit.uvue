		padding: 10px 12px;
		border-radius: 12px;
		background-color: #edf2ef;
	}

	.we-note-text {
		display: block;
		color: #637168;
		font-size: 12px;
		line-height: 1.6;
	}

	.we-list {
		margin-top: 16px;
	}

	.we-empty {
		display: block;
		padding: 28px 0;
		color: #949d98;
		font-size: 14px;
		text-align: center;
	}

	.we-card {
		margin-bottom: 12px;
		padding: 16px;
		border-width: 1px;
		border-style: solid;
		border-color: #e9edea;
		border-radius: 18px;
		background-color: #ffffff;
	}

	.we-card-top {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.we-card-copy {
		flex: 1;
		margin-right: 12px;
	}

	.we-card-name {
		display: block;
		color: #1f2a24;
