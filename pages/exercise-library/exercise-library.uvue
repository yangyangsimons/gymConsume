<template>
	<view class="app-shell">
		<scroll-view class="app-content" scroll-y="true">
			<view class="page-header">
				<text class="eyebrow">动作库</text>
				<text class="heading-1">全部动作</text>
				<text class="sub">共 {{ total }} 个动作 · 云端同步</text>
			</view>

			<view v-if="loading" class="loading">
				<text class="loading-text">加载中…</text>
			</view>
			<view v-else-if="error" class="loading">
				<text class="error-text">{{ error }}</text>
				<button class="retry-btn" @click="loadData">重试</button>
			</view>

			<view v-else>
				<view v-for="group in grouped" :key="group.category" class="category-group">
					<text class="category-title">{{ group.category }}</text>
					<view class="exercise-list">
						<view v-for="ex in group.items" :key="ex._id" class="exercise-item">
							<view class="exercise-icon">
								<text class="icon-text">{{ ex.icon }}</text>
							</view>
							<view class="exercise-info">
								<text class="exercise-name">{{ ex.name }}</text>
								<text class="exercise-sub">{{ ex.sub }}</text>
							</view>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { loadExercises } from '@/services/gym-api.uts'
	import { Exercise } from '@/services/gym-stats.uts'

	const exercises = ref<Exercise[]>([])
	const loading = ref(true)
	const error = ref('')

	type Group = { category : string, items : Exercise[] }
	const grouped = ref<Group[]>([])
	const total = computed(() : number => exercises.value.length)

	const CATEGORY_ORDER = ['胸', '背', '腿', '肩', '手臂', '核心']

	async function loadData() {
		loading.value = true
		error.value = ''
		try {
			const list = await loadExercises()
			exercises.value = list
			// 按分类分组
			const map = new Map<string, Exercise[]>()
			for (let i = 0; i < list.length; i++) {
				const ex = list[i]
				const arr = map.get(ex.category) ?? []
				arr.push(ex)
				map.set(ex.category, arr)
			}
			// 按预定义顺序排列
			const result : Group[] = []
			for (let i = 0; i < CATEGORY_ORDER.length; i++) {
				const cat = CATEGORY_ORDER[i]
				if (map.has(cat)) result.push({ category: cat, items: map.get(cat)! })
			}
			// 处理未在预定义列表中的分类
			map.forEach((items : Exercise[], cat : string) => {
				if (CATEGORY_ORDER.indexOf(cat) == -1) result.push({ category: cat, items: items })
			})
			grouped.value = result
		} catch (e) {
			console.error('Load exercises failed', e)
			error.value = '加载失败，请检查网络'
		}
		loading.value = false
	}

	onShow(() => {
		loadData()
	})
</script>

<style lang="scss">
	@import "@/uni.scss";

