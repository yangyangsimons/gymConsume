		position: relative;
		width: 100%;
		height: 100%;
		font-family: $gym-font-family;
		background-color: $gym-bg-page;
		box-sizing: border-box;
	}

	.app-content {
		width: 100%;
		height: 100%;
		padding: 16px 16px 32px;
		box-sizing: border-box;
	}

	.page-header {
		padding: 8px 2px 24px;
	}

	.eyebrow {
		display: block;
		margin-bottom: 6px;
		color: #7d8982;
		font-size: 11px;
		font-weight: 700;
	}

	.heading-1 {
		font-size: 25px;
		color: #222222;
	}

	.sub {
		display: block;
		margin-top: 6px;
		color: #98a19c;
		font-size: 11px;
	}

	.loading {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 80px 0;
	}

	.loading-text {
		color: #7d8982;
		font-size: 13px;
	}

	.error-text {
		color: #c55c5c;
		font-size: 13px;
		margin-bottom: 16px;
	}

	.retry-btn {
		padding: 8px 20px;
		border-width: 0;
		border-radius: 9px;
		background-color: #22b979;
		color: #ffffff;
		font-size: 12px;
	}

	.category-group {
		margin-bottom: 24px;
	}

		category-title {
		display: block;
		margin-bottom: 10px;
		padding-left: 2px;
		color: #7d8982;
		font-size: 11px;
		font-weight: 700;
	}

	.exercise-list {
		border-width: 1px;
		border-style: solid;
		border-color: #e7ebe8;
		border-radius: 19px;
		background-color: #ffffff;
		overflow: hidden;
	}

	.exercise-item {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 14px 15px;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #edf0ee;
	}

	.exercise-list .exercise-item:last-child {
		border-bottom-width: 0;
	}

	.exercise-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		margin-right: 12px;
		border-radius: 11px;
		background-color: #ebf7f1;
	}

	.icon-text {
		font-size: 14px;
		font-weight: 600;
		color: #159b65;
	}

	.exercise-info {
		flex: 1;
	}

	.exercise-name {
		display: block;
		margin-bottom: 3px;
		font-size: 13px;
		color: #222222;
	}

	.exercise-sub {
		display: block;
		color: #98a19c;
		font-size: 10px;
	}
</style>
