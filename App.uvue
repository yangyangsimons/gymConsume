<script setup lang="uts">
	import { flushCloud, pauseCloudSync, resumeCloudSync } from '@/services/gym-cloud.uts'
	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		console.log('App Launch')
		    if (!wx.cloud) {
      console.error('当前微信基础库不支持云开发')
      return
    }

    wx.cloud.init({
      env: 'cloud1-d0gjxp9f1819c8c1e',
      traceUser: true
    })
		console.log('Cloud initialized')
		wx.onNetworkStatusChange((status) => {
			if (status.isConnected) resumeCloudSync(true).catch((e : unknown) => console.error('Network recovery sync failed', e))
		})
		resumeCloudSync().catch((e : unknown) => console.error('Initial cloud load failed', e))
	})

	onAppShow(() => {
		console.log('App Show')
		resumeCloudSync().catch((e : unknown) => console.error('Foreground cloud load failed', e))
	})

	onAppHide(() => {
		console.log('App Hide')
		pauseCloudSync()
		flushCloud().catch((e : unknown) => console.error('Background sync retained locally', e))
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('App Exit')
	})
	// #endif
</script>

<style>
	/*每个页面公共css */
	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}

	/* #ifdef MP-WEIXIN */
	/* 隐藏页面级滚动和 scroll-view 的滚动条（scroll-view 另需 show-scrollbar=false） */
	::-webkit-scrollbar {
		display: none;
		width: 0;
		height: 0;
		color: transparent;
		background: transparent;
	}
	/* #endif */
</style>
